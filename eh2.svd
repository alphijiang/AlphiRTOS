<device schemaVersion="1.1" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD_Schema_1_1.xsd" >
  <vendor>Syntronix Corp.</vendor>                                       <!-- device vendor name -->
  <vendorID>STX</vendorID>                                        <!-- device vendor short name -->
  <name>eh2</name>                                          <!-- name of part-->
  <series>Core-VeeR</series>                                         <!-- device series the device belongs to -->
  <version>1.4</version>                                          <!-- version of this description, adding CMSIS-SVD 1.1 tags -->
  <description> 32-bit RISC-V  Microcontroller based device, CPU clock up to 50MHz, etc. </description>
  <licenseText>                                                   <!-- this license text will appear in header file. \n force line breaks -->
   Copyright (c) 2014-2026 Syntronix AI Corp.  All rights reserved.\n
 Software License Agreement\n
 \n
 \n
 THIS SOFTWARE IS PROVIDED "AS IS" AND WITH ALL FAULTS.\n
 NO WARRANTIES, WHETHER EXPRESS, IMPLIED OR STATUTORY, INCLUDING, BUT\n
 NOT LIMITED TO, IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR\n
 A PARTICULAR PURPOSE APPLY TO THIS SOFTWARE. TI SHALL NOT, UNDER ANY\n
 CIRCUMSTANCES, BE LIABLE FOR SPECIAL, INCIDENTAL, OR CONSEQUENTIAL\n
 DAMAGES, FOR ANY REASON WHATSOEVER.
  </licenseText>
  <cpu>                                                           <!-- details about the cpu embedded in the device -->
    <name>other</name>
    <revision>r1p0</revision>
    <endian>little</endian>
    <mpuPresent>true</mpuPresent>
    <fpuPresent>false</fpuPresent>
    <nvicPrioBits>3</nvicPrioBits>
    <vendorSystickConfig>false</vendorSystickConfig>
  </cpu>
  <addressUnitBits>8</addressUnitBits>                            <!-- byte addressable memory -->
  <width>64</width>                                               <!-- bus width is 32 bits -->
  <!-- default settings implicitly inherited by subsequent sections -->
  <size>64</size>                                                 <!-- this is the default size (number of bits) of all peripherals
                                                                       and register that do not define "size" themselves -->
  <access>read-write</access>                                     <!-- default access permission for all subsequent registers -->
  <resetValue>0x00000000</resetValue>                             <!-- by default all bits of the registers are initialized to 0 on reset -->
  <resetMask>0xFFFFFFFF</resetMask>                               <!-- by default all 32Bits of the registers are used -->

  <peripherals>
    <peripheral>
      <name>SYSCON</name>
      <description>System Controller Peripheral for VeeRwolf SoC</description>
      <groupName>SYSCON</groupName>
      <baseAddress>0x80001000</baseAddress>
      <addressBlock>
        <offset>0x00</offset>
        <size>0x40</size>
        <usage>registers</usage>
      </addressBlock>

      <registers>
        <!-- Offset 0x00: version_patch -->
        <register>
          <name>VERSION_PATCH</name>
          <description>VeeRwolf patch version</description>
          <addressOffset>0x00</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>PATCH</name>
              <description>Patch version number</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>

        <!-- Offset 0x01: version_minor -->
        <register>
          <name>VERSION_MINOR</name>
          <description>VeeRwolf minor version</description>
          <addressOffset>0x01</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>MINOR</name>
              <description>Minor version number</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>

        <!-- Offset 0x02: version_major -->
        <register>
          <name>VERSION_MAJOR</name>
          <description>VeeRwolf major version</description>
          <addressOffset>0x02</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>MAJOR</name>
              <description>Major version number</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>

        <!-- Offset 0x03: version_misc -->
        <register>
          <name>VERSION_MISC</name>
          <description>VeeRwolf misc version info</description>
          <addressOffset>0x03</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>REV</name>
              <description>Revision since last patch version</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
            <field>
              <name>MODIFIED</name>
              <description>Set when VeeRwolf was built from modified sources</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>

        <!-- Offset 0x04-0x07: version_sha -->
        <register>
          <name>VERSION_SHA</name>
          <description>SHA hash of the build</description>
          <addressOffset>0x04</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SHA</name>
              <description>Build SHA hash</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>

        <!-- Offset 0x08: sim_print -->
        <register>
          <name>SIM_PRINT</name>
          <description>Outputs a character in simulation. No effect on hardware</description>
          <addressOffset>0x08</addressOffset>
          <size>8</size>
          <access>write-only</access>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>CHAR</name>
              <description>Character output to simulation console</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>

        <!-- Offset 0x09: sim_exit -->
        <register>
          <name>SIM_EXIT</name>
          <description>Exits a simulation. No effect on hardware</description>
          <addressOffset>0x09</addressOffset>
          <size>8</size>
          <access>write-only</access>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>EXIT_CODE</name>
              <description>Simulation exit code</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>

        <!-- Offset 0x0A: init_status -->
        <register>
          <name>INIT_STATUS</name>
          <description>RAM Initialization Status</description>
          <addressOffset>0x0A</addressOffset>
          <size>8</size>
          <access>read-only</access>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>RAM_INIT_DONE</name>
              <description>RAM initialization complete</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RAM_INIT_ERR</name>
              <description>RAM initialization reported errors</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>

        <!-- Offset 0x0B: sw_irq -->
        <register>
          <name>SW_IRQ</name>
          <description>Software-controlled external interrupts</description>
          <addressOffset>0x0B</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>SW_IRQ</name>
              <description>Software interrupt bits</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>

        <!-- Offset 0x0C-0x0F: nmi_vec -->
        <register>
          <name>NMI_VEC</name>
          <description>Interrupt vector for NMI</description>
          <addressOffset>0x0C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>VEC</name>
              <description>NMI vector address</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>

        <!-- Offset 0x10-0x13: gpio0 -->
        <register>
          <name>GPIO0</name>
          <description>32 readable and writable GPIO bits</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>PINS</name>
              <description>GPIO0 pins state/control</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>

        <!-- Offset 0x18-0x1B: gpio1 -->
        <register>
          <name>GPIO1</name>
          <description>32 readable and writable GPIO bits</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>PINS</name>
              <description>GPIO1 pins state/control</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>

        <!-- Offset 0x20-0x27: mtime -->
        <register>
          <name>MTIMEL</name>
          <description>mtime from RISC-V privilege spec</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000000000000000</resetValue>

        </register>

         <register>
          <name>MTIMEH</name>
          <description>mtime from RISC-V privilege spec</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000000000000000</resetValue>

        </register>


        <!-- Offset 0x28-0x2F: mtimecmp -->
        <register>
          <name>MTIMECMPL</name>
          <description>mtimecmp from RISC-V privilege spec</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000000000000000</resetValue>
        
        </register>

         <register>
          <name>MTIMECMPH</name>
          <description>mtimecmp from RISC-V privilege spec</description>
          <addressOffset>0x2C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000000000000000</resetValue>
        
        </register>

        <!-- Offset 0x30-0x33: irq_timer_cnt -->
        <register>
          <name>IRQ_TIMER_CNT</name>
          <description>IRQ timer counter</description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CNT</name>
              <description>IRQ timer count value</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>

        <!-- Offset 0x34: irq_timer_ctrl -->
        <register>
          <name>IRQ_TIMER_CTRL</name>
          <description>IRQ timer control</description>
          <addressOffset>0x34</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0x00</resetValue>
          <fields>
            <field>
              <name>CTRL</name>
              <description>IRQ timer control flags</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>

        <!-- Offset 0x3C-0x3F: clk_freq_hz -->
        <register>
          <name>CLK_FREQ_HZ</name>
          <description>Clock frequency of main clock in Hz</description>
          <addressOffset>0x3C</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
        </register>
      </registers>
    </peripheral>
<peripheral>
    <name>SPI</name>
    <description>Serial Peripheral Interface (SPI) with Union/Aliasing Registers</description>
    <groupName>SPI</groupName>
    <baseAddress>0x80001040</baseAddress>
    <addressBlock>
        <offset>0x0</offset>
        <size>0x10</size>
        <usage>registers</usage>
    </addressBlock>
    <interrupt>
    <name>SPI</name>
    <description>SPI Interrupt Output Signal</description>
    <value>2</value>
  </interrupt>
    <registers>
        <register>
            <name>CR</name>
            <description>Simple SPI Control register</description>
            <addressOffset>0x00</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
                <field>
                    <name>SPIE</name>
                    <description>Serial Peripheral Interrupt Enable</description>
                    <bitRange>[7:7]</bitRange>
                </field>
                <field>
                    <name>SPE</name>
                    <description>Serial Peripheral Enable</description>
                    <bitRange>[6:6]</bitRange>
                </field>

                <field>
                    <name>MSTR</name>
                    <description>Master Mode Select</description>
                    <bitRange>[4:4]</bitRange>
                </field>

                <field>
                    <name>CPOL</name>
                    <description>Clock Polarity</description>
                    <bitRange>[3:3]</bitRange>
                </field>

                <field>
                    <name>CPHA</name>
                    <description>Clock Phase</description>
                    <bitRange>[2:2]</bitRange>
                </field>

                <field>
                    <name>SPR</name>
                    <description>SPI Clock Rate Select</description>
                    <bitRange>[1:0]</bitRange>
                </field>
            </fields>
        </register>

        <register>
            <name>SR</name>
            <description>Simple SPI status register</description>
            <addressOffset>0x08</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000002</resetValue>
            <fields>
                <field>
                    <name>SPIF</name>
                    <description>Serial Peripheral Interrupt Flag</description>
                    <bitRange>[7:7]</bitRange>
                </field>
                <field>
                    <name>WCOL</name>
                    <description>Write Collision Flag</description>
                    <bitRange>[6:6]</bitRange>
                </field>
                <field>
                    <name>WFFULL</name>
                    <description>Write FIFO Full</description>
                    <bitRange>[3:3]</bitRange>
                </field>
                <field>
                    <name>WFEMPTY</name>
                    <description>Write FIFO Empty</description>
                    <bitRange>[2:2]</bitRange>
                </field>
                <field>
                    <name>RFFULL</name>
                    <description>Read FIFO Full</description>
                    <bitRange>[1:1]</bitRange>
                </field>
                <field>
                    <name>RFEMPTY</name>
                    <description>Read FIFO Empty</description>
                    <bitRange>[0:0]</bitRange>
                </field>
            </fields>
        </register>

        <register>
            <name>DR</name>
            <description>Simple SPI data register</description>
            <addressOffset>0x10</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
        </register>



        <register>
            <name>ER</name>
            <description>Simple SPI extended register</description>
            <addressOffset>0x18</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
                <field>
                    <name>ICNT</name>
                    <description>Interrupt Count\n
                        00 SPIF is set after every completed transfer \n
                        01 SPIF is set after every two completed transfers \n
                        10 SPIF is set after every three completed transfers \n
                        11 SPIF is set after every four completed transfers
                    </description>
                    <bitRange>[7:6]</bitRange>
                </field>
                <field>
                    <name>ESPR</name>
                    <description>Extended SPI Clock Rate Select\n
                        00 SPR is used to generate the SPI clock \n
                        01 SPR is multiplied by 2 to generate the SPI clock \n
                        10 SPR is multiplied by 4 to generate the SPI clock \n
                        11 SPR is multiplied by 8 to generate the SPI clock
                    </description>
                    <bitRange>[1:0]</bitRange>
                </field>
            </fields>
        </register>

        <register>
            <name>SS</name>
            <description>Simple SPI slave select register</description>
            <addressOffset>0x20</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>

        </register>

    </registers>
</peripheral>
<peripheral>
  <name>UART</name>
  <description>UART16550 IP Core with Wishbone Interface</description>
  <baseAddress>0x80002000</baseAddress>
  <addressBlock>
    <offset>0x00</offset>
    <size>0x10</size>
    <usage>registers</usage>
  </addressBlock>
  <interrupt>
    <name>UART</name>
    <description>UART Interrupt Output Signal</description>
    <value>1</value>
  </interrupt>
  <registers>

    <!-- Address Offset 0x00: Union of RBR (R), THR (W), and DLL (RW when DLAB=1) -->
    <register>
      <name>RBR</name>
      <description>Receiver Buffer Register (Read Only, DLAB=0)</description>
      <addressOffset>0x00</addressOffset>
      <size>8</size>
      <access>read-only</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field>
          <name>RBR</name>
          <description>Receiver FIFO output byte</description>
          <bitOffset>0</bitOffset>
          <bitWidth>8</bitWidth>
        </field>
      </fields>
    </register>

    <register>
      <name>THR</name>
      <alternateRegister>RBR</alternateRegister>
      <description>Transmitter Holding Register (Write Only, DLAB=0)</description>
      <addressOffset>0x00</addressOffset>
      <size>8</size>
      <access>write-only</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field>
          <name>THR</name>
          <description>Transmit FIFO input byte</description>
          <bitOffset>0</bitOffset>
          <bitWidth>8</bitWidth>
        </field>
      </fields>
    </register>

    <register>
      <name>DLL</name>
      <alternateRegister>RBR</alternateRegister>
      <description>Divisor Latch Byte 1 LSB (Read/Write, DLAB=1)</description>
      <addressOffset>0x00</addressOffset>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field>
          <name>DLL</name>
          <description>The LSB of the divisor latch</description>
          <bitOffset>0</bitOffset>
          <bitWidth>8</bitWidth>
        </field>
      </fields>
    </register>

    <!-- Address Offset 0x01: Union of IER (DLAB=0) and DLM (DLAB=1) -->
    <register>
      <name>IER</name>
      <description>Interrupt Enable Register (Read/Write, DLAB=0)</description>
      <addressOffset>0x04</addressOffset>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field>
          <name>ERBFI</name>
          <description>Enable Received Data Available Interrupt</description>
          <bitOffset>0</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>ETBEI</name>
          <description>Enable Transmitter Holding Register Empty Interrupt</description>
          <bitOffset>1</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>ELSI</name>
          <description>Enable Receiver Line Status Interrupt</description>
          <bitOffset>2</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>EDSSI</name>
          <description>Enable Modem Status Interrupt</description>
          <bitOffset>3</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
      </fields>
    </register>

    <register>
      <name>DLM</name>
      <alternateRegister>IER</alternateRegister>
      <description>Divisor Latch Byte 2 MSB (Read/Write, DLAB=1)</description>
      <addressOffset>0x04</addressOffset>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x00</resetValue>
      <fields>
        <field>
          <name>DLM</name>
          <description>The MSB of the divisor latch</description>
          <bitOffset>0</bitOffset>
          <bitWidth>8</bitWidth>
        </field>
      </fields>
    </register>

    <!-- Address Offset 0x02: Union of IIR (R) and FCR (W) -->
    <register>
      <name>IIR</name>
      <description>Interrupt Identification Register (Read Only)</description>
      <addressOffset>0x08</addressOffset>
      <size>8</size>
      <access>read-only</access>
      <resetValue>0xC1</resetValue>
      <fields>
        <field>
          <name>IPEND</name>
          <description>Interrupt Pending ('0': Pending, '1': No interrupt pending)</description>
          <bitOffset>0</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>INTID</name>
          <description>Interrupt Identification ID</description>
          <bitOffset>1</bitOffset>
          <bitWidth>3</bitWidth>
        </field>
        <field>
          <name>FIFOEN</name>
          <description>FIFOs Enabled indicator (Fixed logic '11')</description>
          <bitOffset>6</bitOffset>
          <bitWidth>2</bitWidth>
        </field>
      </fields>
    </register>

    <register>
      <name>FCR</name>
      <alternateRegister>IIR</alternateRegister>
      <description>FIFO Control Register (Write Only)</description>
      <addressOffset>0x08</addressOffset>
      <size>8</size>
      <access>write-only</access>
      <resetValue>0xC0</resetValue>
      <fields>
        <field>
          <name>FIFOEN</name>
          <description>FIFO Enable (Ignored in core)</description>
          <bitOffset>0</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>RCVRCLR</name>
          <description>Receiver FIFO Clear</description>
          <bitOffset>1</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>XMITCLR</name>
          <description>Transmitter FIFO Clear</description>
          <bitOffset>2</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>RXTRIG</name>
          <description>Receiver FIFO Interrupt Trigger Level ('00':1B, '01':4B, '10':8B, '11':14B)</description>
          <bitOffset>6</bitOffset>
          <bitWidth>2</bitWidth>
        </field>
      </fields>
    </register>

    <!-- Address Offset 0x03: LCR -->
    <register>
      <name>LCR</name>
      <description>Line Control Register (Read/Write)</description>
      <addressOffset>0x0C</addressOffset>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x03</resetValue>
      <fields>
        <field>
          <name>WLS</name>
          <description>Word Length Select ('00':5b, '01':6b, '10':7b, '11':8b)</description>
          <bitOffset>0</bitOffset>
          <bitWidth>2</bitWidth>
        </field>
        <field>
          <name>STB</name>
          <description>Stop Bit Select</description>
          <bitOffset>2</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>PEN</name>
          <description>Parity Enable</description>
