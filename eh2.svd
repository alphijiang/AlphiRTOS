<device schemaVersion="1.1" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD_Schema_1_1.xsd" >
  <vendor>Syntronix Corp.</vendor>                                       <!-- device vendor name -->
  <vendorID>STX</vendorID>                                        <!-- device vendor short name -->
  <name>eh2</name>                                          <!-- name of part-->
  <series>eh2</series>                                         <!-- device series the device belongs to -->
  <version>1.2</version>                                          <!-- version of this description, adding CMSIS-SVD 1.1 tags -->
  <description> 32-bit RISC-V  Microcontroller based device, CPU clock up to 50MHz, etc. </description>
  <licenseText>                                                   <!-- this license text will appear in header file. \n force line breaks -->
   Copyright (c) 2014-2025 Syntronix Corp.  All rights reserved.\n
 Software License Agreement\n
 \n
 \n
 THIS SOFTWARE IS PROVIDED "AS IS" AND WITH ALL FAULTS.\n
 NO WARRANTIES, WHETHER EXPRESS, IMPLIED OR STATUTORY, INCLUDING, BUT\n
 NOT LIMITED TO, IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR\n
 A PARTICULAR PURPOSE APPLY TO THIS SOFTWARE. TI SHALL NOT, UNDER ANY\n
 CIRCUMSTANCES, BE LIABLE FOR SPECIAL, INCIDENTAL, OR CONSEQUENTIAL\n
 DAMAGES, FOR ANY REASON WHATSOEVER.
  </licenseText>
  <cpu>                                                           <!-- details about the cpu embedded in the device -->
    <name>CM0</name>
    <revision>r1p0</revision>
    <endian>little</endian>
    <mpuPresent>true</mpuPresent>
    <fpuPresent>false</fpuPresent>
    <nvicPrioBits>3</nvicPrioBits>
    <vendorSystickConfig>false</vendorSystickConfig>
  </cpu>
  <addressUnitBits>8</addressUnitBits>                            <!-- byte addressable memory -->
  <width>64</width>                                               <!-- bus width is 32 bits -->
  <!-- default settings implicitly inherited by subsequent sections -->
  <size>64</size>                                                 <!-- this is the default size (number of bits) of all peripherals
                                                                       and register that do not define "size" themselves -->
  <access>read-write</access>                                     <!-- default access permission for all subsequent registers -->
  <resetValue>0x00000000</resetValue>                             <!-- by default all bits of the registers are initialized to 0 on reset -->
  <resetMask>0xFFFFFFFF</resetMask>                               <!-- by default all 32Bits of the registers are used -->

  <peripherals>
<peripheral>
  <name>SYSCON</name>
  <version>1.0</version>
  <description>System Control Register</description>
  <groupName>SYSCON</groupName>
  <baseAddress>0x80001000</baseAddress>
  <size>32</size>
  <access>read-write</access>
  <addressBlock>
    <offset>0</offset>
    <size>0x1000</size>
    <usage>registers</usage>
  </addressBlock>
  <registers>
  <register>
      <name>VERSION</name>
      <description>Version Register</description>
      <addressOffset>0x00</addressOffset>
      <size>32</size>
      <access>read-only</access>
      <fields>
        <field>
          <name>VERSION_PATCH</name>
          <description>RVeeRwolf patch version</description>
          <bitRange>[7:0]</bitRange>
          <access>read-only</access>
        </field>
        <field>
          <name>VERSION_MINOR</name>
            <description>VeeRwolf minor version</description>
          <bitRange>[15:8]</bitRange>
          <access>read-only</access>
        </field>
        <field>
          <name>VERSION_MAJOR</name>
          <description>VeeRwolf major version</description>
          <bitRange>[23:16]</bitRange>
          <access>read-only</access>
        </field>
        <field>
            <name>VERSION_MISC</name>
            <description>VeeRwolf patch version</description>
          <bitRange>[31:24]</bitRange>
          <access>read-only</access>
        </field>
      </fields>
    </register>

    <!-- CLKENST: Control Register -->

    <register>
      <name>VERSION_SHA</name>
      <description>VeeRwolf patch version</description>
      <addressOffset>0x04</addressOffset>
      <size>32</size>
      <access>read-only</access>
    </register>

    <register>
      <name>SW_IRQ</name>
      <description>Software-controlled external interrupts</description>
      <addressOffset>0x08</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <fields>
        <field>
          <name>sw_irq4</name>
          <description>Trigger IRQ line 4</description>
          <bitRange>[31:31]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>sw_irq4_edge</name>
          <description>0 = IRQ4 is asserted until sw_irq4 is cleared\n
                       1 = Writing to sw_irq4 only asserts IRQ4 for one clock cycle
          </description>
          <bitRange>[30:30]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>sw_irq4_pol</name>
          <description>IRQ4 polarity.\n
                       0 = Active high\n
                       1 = active low
          </description>
          <bitRange>[29:29]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>sw_irq4_timer</name>
          <description>0 = IRQ4 is triggered by sw_irq4\n
                       1 = IRQ4 is triggered by irq_timer timeout
          </description>
          <bitRange>[28:28]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>sw_irq3</name>
          <description>Trigger IRQ line 3</description>
          <bitRange>[27:27]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>sw_irq3_edge</name>
           <description>0 = IRQ3 is asserted until sw_irq4 is cleared\n
                       1 = Writing to sw_irq4 only asserts IRQ3 for one clock cycle
          </description>
          <bitRange>[26:26]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>sw_irq3_pol</name>
          <description>IRQ3 polarity.\n
                       0 = Active high\n
                       1 = active low
          </description>
          <bitRange>[25:25]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>sw_irq3_timer</name>
          <description>Trigger IRQ line 3</description>
          <bitRange>[24:24]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>mbist_error</name>
          <description>MBIST error</description>
          <bitRange>[17:17]</bitRange>
          <access>read-only</access>
        </field>
         <field>
          <name>mbist_done</name>
          <description>MBIST done</description>
          <bitRange>[16:16]</bitRange>
          <access>read-only</access>
        </field>
      </fields>
    </register>
    <register>
      <name>NMI_VEC</name>
      <description>Interrupt vector for NMI</description>
      <addressOffset>0x0C</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
    </register>

    <register>
      <name>SIM_GPIO0</name>
      <description>Simulation GPIO 0</description>
      <addressOffset>0x10</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
    </register>

     <register>
      <name>SIM_GPIO1</name>
      <description>Simulation GPIO 1</description>
      <addressOffset>0x18</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
    </register>

     <register>
      <name>MTIME0L</name>
      <description>mtime0 low cycle from RISC-V privilege spec</description>
      <addressOffset>0x20</addressOffset>
      <size>32</size>
      <access>read-write</access>
    </register>
     <register>
      <name>MTIME0H</name>
      <description>mtime0 high cycle from RISC-V privilege spec</description>
      <addressOffset>0x24</addressOffset>
      <size>32</size>
      <access>read-write</access>
    </register>
     <register>
      <name>MTIMECMP0L</name>
      <description>mtimecmp0 low cycle from RISC-V privilege spec</description>
      <addressOffset>0x28</addressOffset>
      <size>32</size>
      <access>read-write</access>
    </register>
     <register>
      <name>MTIMECMP0H</name>
      <description>mtimecmp0 high cycle from RISC-V privilege spec</description>
      <addressOffset>0x2C</addressOffset>
      <size>32</size>
      <access>read-write</access>
    </register>
     <register>
      <name>IRQ_TIMER_CNT</name>
      <description>IRQ timer counter</description>
      <addressOffset>0x30</addressOffset>
      <size>32</size>
      <access>read-write</access>
    </register>
    <register>
      <name>IRQ_TIMER_CTRL</name>
      <description>IRQ timer control</description>
      <addressOffset>0x34</addressOffset>
      <size>8</size>
      <access>read-write</access>
    </register>
    <register>
      <name>CLK_FREQ_HZ</name>
      <description>Clock frequency of main clock in Hz</description>
      <addressOffset>0x3C</addressOffset>
      <size>32</size>
      <access>read-only</access>
    </register>
     <register>
      <name>MTIME1L</name>
      <description>mtime1 low cycle from RISC-V privilege spec</description>
      <addressOffset>0x40</addressOffset>
      <size>32</size>
      <access>read-write</access>
    </register>
    <register>
      <name>MTIME1H</name>
      <description>mtime1 high cycle from RISC-V privilege spec</description>
      <addressOffset>0x44</addressOffset>
      <size>32</size>
      <access>read-write</access>
    </register>
     <register>
      <name>MTIMECMP1L</name>
      <description>mtimecmp1 low cycle from RISC-V privilege spec</description>
      <addressOffset>0x48</addressOffset>
      <size>32</size>
      <access>read-write</access>
    </register>
     <register>
      <name>MTIMECMP1H</name>
      <description>mtimecmp1 low cycle from RISC-V privilege spec</description>
      <addressOffset>0x4C</addressOffset>
      <size>32</size>
      <access>read-write</access>
    </register>
    <register>
      <name>PACENSET</name>
      <description>Periphererl Clock Enable</description>
      <addressOffset>0x50</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <fields>
        <field>
          <name>P_SYSCON</name>
          <description>
						0: SYSCON Clock disabled\n
						1: SYSCON Clock enabled
          </description>
          <bitRange>[1:1]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>P_SPI0</name>
          <description>
						0: SPI0 Clock disabled\n
						1: SPI0 Clock enabled
          </description>
          <bitRange>[2:2]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>P_UART</name>
          <description>
						0: UART Clock disabled\n
						1: UART Clock enabled
          </description>
          <bitRange>[3:3]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>P_I2C</name>
          <description>
						0: I2C Clock disabled\n
						1: I2C Clock enabled
          </description>
          <bitRange>[4:4]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>P_PWM</name>
          <description>
						0: PWM Clock disabled\n
						1: PWM Clock enabled
          </description>
          <bitRange>[5:5]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>P_GPIO0</name>
          <description>
						0: GPIO0 Clock disabled\n
						1: GPIO0 Clock enabled
          </description>
          <bitRange>[6:6]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>P_GPIO1</name>
          <description>
						0: GPIO1 Clock disabled\n
						1: GPIO1 Clock enabled
          </description>
          <bitRange>[7:7]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>P_AIMC</name>
          <description>
						0: no effect\n
						1: IGZO AiMC Clock enabled
          </description>
          <bitRange>[10:10]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>P_OPI</name>
          <description>
						0: no effect\n
						1: OPI Clock enabled
          </description>
          <bitRange>[11:11]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>P_SPI1</name>
          <description>
						0: SPI1 Clock disabled\n
						1: SPI1 Clock enabled
          </description>
          <bitRange>[12:12]</bitRange>
          <access>read-write</access>
        </field>

      </fields>
    </register>
    <register>
      <name>PACENCLR</name>
      <description>Periphererl Clock Disable</description>
      <addressOffset>0x54</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <fields>
        <field>
          <name>P_SYSCON</name>
          <description>
						0: SYSCON Clock disabled\n
						1: SYSCON Clock enabled
          </description>
          <bitRange>[1:1]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>P_SPI0</name>
          <description>
						0: SPI0 Clock disabled\n
						1: SPI0 Clock enabled
          </description>
          <bitRange>[2:2]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>P_UART</name>
          <description>
						0: UART Clock disabled\n
						1: UART Clock enabled
          </description>
          <bitRange>[3:3]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>P_I2C</name>
          <description>
						0: I2C Clock disabled\n
						1: I2C Clock enabled
          </description>
          <bitRange>[4:4]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>P_PWM</name>
          <description>
						0: PWM Clock disabled\n
						1: PWM Clock enabled
          </description>
          <bitRange>[5:5]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>P_GPIO0</name>
          <description>
						0: GPIO0 Clock disabled\n
						1: GPIO0 Clock enabled
          </description>
          <bitRange>[6:6]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>P_GPIO1</name>
          <description>
						0: GPIO1 Clock disabled\n
						1: GPIO1 Clock enabled
          </description>
          <bitRange>[7:7]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>P_AIMC</name>
          <description>
						0: no effect\n
						1: IGZO AiMC Clock disable
          </description>
          <bitRange>[10:10]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>P_OPI</name>
          <description>
						0: no effect\n
						1: OPI Clock disable
          </description>
          <bitRange>[11:11]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>P_SPI1</name>
          <description>
						0: SPI1 Clock disabled\n
						1: SPI1 Clock enabled
          </description>
          <bitRange>[12:12]</bitRange>
          <access>read-write</access>
        </field>


      </fields>
    </register>
  </registers>
</peripheral>
<peripheral>
    <name>UART</name>
    <version>1.0</version>
    <description>Universal Asynchronous Receiver Transmitter</description>
    <groupName>UART</groupName>
    <baseAddress>0x80003000</baseAddress>
    <size>32</size>
    <access>read-write</access>
    <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
    </addressBlock>

    <registers>


        <register>
            <name>IdRev</name>
            <description>ID and Revision Register</description>
            <addressOffset>0x00</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
        </register>

        <register>
            <name>Cfg</name>
            <description>Hardware Configure Register\n
                  0: 16-byte FIFO \n
                  1: 32-byte FIFO \n
                  2: 64-byte FIFO
            </description>
            <addressOffset>0x10</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
        </register>

        <register>
            <name>OSCR</name>
            <description>Over Sample Control Register \n
      The value must be an even number; any odd value  \n
writes to this field will be converted to an even value.  \n
OOOOOO = 00: The over-sample ratio is 32  \n
OOOOOO \u2264 8: The over-sample ratio is 8  \n
8  ~  32 The over sample ratio is OSC  \n
            </description>
            <addressOffset>0x10</addressOffset>
            <size>14</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
        </register>

        <register>
            <name>RBR</name>
            <alternateRegister>THR</alternateRegister>
            <description>Receiver Buffer Register</description>
            <addressOffset>0x20</addressOffset>
            <size>32</size>
            <access>read-only</access>
        </register>

        <register>
            <name>THR</name>
            <alternateRegister>RBR</alternateRegister>
            <description>Transmitter Holding Register</description>
            <addressOffset>0x20</addressOffset>
            <access>write-only</access>
            <size>32</size>
        </register>

        <register>
            <name>DLL</name>
            <description>Divisor Latch LSB(DLAB=1)</description>
            <addressOffset>0x20</addressOffset>
            <size>32</size>
        </register>


        <!-- IER: Status Register   -->
        <register>
            <name>IER</name>
            <alternateRegister>DLM</alternateRegister>
            <description>Interrupt Register</description>
            <addressOffset>0x24</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
                <field>
                    <name>ERBI</name>
                    <description
                    >Enable received data available interrupt and the character timeout interrupt
                       0: disabled \n
                       1: enable
                    </description>
                    <bitRange>[0:0]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>ETHEI</name>
                    <description>Enable transmitter holding register interrupt \n
                       0: disabled \n
                       1: enable
                    </description>
                    <bitRange>[1:1]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>ELSI</name>
                    <description>Enable receiver line status interrupt \n
                       0: disabled \n
                       1: enable
                    </description>
                    <bitRange>[2:2]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>EMSI</name>
                    <description>Enable modem status interrupt \n
                       0: disabled \n
                       1: enable
                    </description>
                    <bitRange>[3:3]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>DLM</name>
            <description>Divisor Latch MSB(DLAB=1)</description>
            <addressOffset>0x24</addressOffset>
            <size>32</size>
        </register>


        <register>
            <name>IIR</name>
            <alternateRegister>FCR</alternateRegister>
            <description>Interrupt Identification Register (Read only)</description>
            <addressOffset>0x28</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
                <field>
                    <name>FIFOED</name>
                    <description>FIFOs enabled\n
                                 These two bits are 1 when bit 0 of the FIFO Control\n
                                 Register (FIFOE) is set to 1.
                    </description>
                    <bitRange>[7:6]</bitRange>
                    <access>read-only</access>
                </field>
                <field>
                    <name>INTRID</name>
                    <description>Interrupt ID \n
                                 See Table 1 for encodings

                    </description>
                    <bitRange>[3:0]</bitRange>
                    <access>read-only</access>
                </field>
                
            </fields>
        </register>
        <register>
            <name>FCR</name>
            <description>FIFO Control Register</description>
            <addressOffset>0x28</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
                <field>
                    <name>FIFOE</name>
                    <description>FIFO enable \n
                       Write 1 to enable both the transmitter and receiver FIFOs.</description>
                    <bitRange>[0:0]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>RFIFORST</name>
                    <description>Writing a 1 to bit 1 clears the Receiver FIFO and resets its logic.\n
                       But it doesn't clear the shift register, i.e. receiving of the current
                        character continues.
                    </description>
                    <bitRange>[1:1]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>TFIFORST</name>
                    <description>TX Interrupt Enable.\n0: Disable\n1: Enable</description>
                    <bitRange>[2:2]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>DMAE</name>
                    <description>DMA enable \n</description>
                    <bitRange>[3:3]</bitRange>
                    <access>read-write</access>
                </field>

                <field>
                    <name>TFIFOT</name>
                    <description>Transmitter FIFO trigger level \n</description>
                    <bitRange>[5:4]</bitRange>
                    <access>read-write</access>
                </field>

                <field>
                    <name>RFIFOT</name>
                    <description>Receiver FIFO trigger level \n</description>
                    <bitRange>[7:6]</bitRange>
                    <access>read-write</access>
                </field>

            </fields>
        </register>

        <register>
            <name>LCR</name>
            <description>Line Control Register</description>
            <addressOffset>0x2C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
                <field>
                    <name>WLS</name>
                    <description>SWord length setting \n
                       00: 5 bits\n
                       01: 6 bits\n
                       10: 7 bits\n
                       11: 8 bits\n
                    </description>
                    <bitRange>[1:0]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>SBS</name>
                    <description>Specify the number of generated stop bits.\n
                       0: 1 stop bit\n
                       1: 1.5 stop bit when 5bit character length selected and 2 stop bits otherwirse
                    </description>
                    <bitRange>[2:2]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>PEN</name>
                    <description>Parity Enable\n
                       0: No Parity\n
                       1: Parity bit is generated on each outgoing character and is checked on each incoming one.
                    </description>
                    <bitRange>[3:3]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>EPS</name>
                    <description>
          Even Parity select\n
          0: Odd number of 1 is transmitted and checked in each word (data and parity combined). \nIn other words, if the data has an
even number of 1in it, then the parity bit is 1\n
          1: Even number of 1 is transmitted in each word
                    </description>
                    <bitRange>[4:4]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>SPS</name>
                    <description>Stick Parity bit\n
                       0: Stick Parity disabled \n
                       1: If bits 3 and 4 are logic 1 , the parity bit is transmitted and checked as logic 0. If bit 3 is 1 and bit 4 is 0 then the
                            parity bit is transmitted and checked as 1.
                    </description>
                    <bitRange>[5:5]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>BC</name>
                    <description>Break Control bit\n
                       0: break is disabled\n
                       1: the serial out is forced into logic 0</description>
                    <bitRange>[6:6]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>DLAB</name>
                    <description>Divisor Latch Access bit.\n
                      0: The normal registers are accessed\n
                    1: The divisor latches can be accessed</description>
                    <bitRange>[7:7]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>MCR</name>
            <description>Modem Control Register</description>
            <addressOffset>0x30</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
                <field>
                    <name>DTR</name>
                    <description>Data Terminal Ready (DTR) signal control\n
                       0: DTR is 1\n
                       1: DTR is 0
                    </description>
                    <bitRange>[0:0]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>RTS</name>
                    <bitRange>[1:1]</bitRange>
                    <description>Request To Send (RTS) signal control\n
                       0 : RTS is 1 \n
                       1 : RTS is 0 \n
                    </description>
                    <access>read-write</access>
                </field>
                <field>
                    <name>OUT1</name>
                    <bitRange>[2:2]</bitRange>
                    <description
                    >Out1. In loopback mode, connected Ring Indicator (RI) signal input</description>
                    <access>read-write</access>
                </field>
                <field>
                    <name>OUT2</name>
                    <bitRange>[3:3]</bitRange>
                    <description
                    >Out2. In loopback mode, connected to Data Carrier Detect (DCD)input.</description>
                    <access>read-write</access>
                </field>
                <field>
                    <name>LOOP</name>
                    <bitRange>[4:4]</bitRange>
                    <description>
            Loopback mode\n
            0: normal operation\n
            1: loopback mode. When in loopback mode, the Serial\n
               Output Signal (STX_PAD_O) is set to logic 1. The signal of the\n
               transmitter shift register is internally connected to the input of the\n
               receiver shift register.\n
               The following connections are made:\n
              DTR - DSR \n
              RTS - CTS \n
              Out1 - RI \n
              Out2 - DCD \n

                    </description>
                    <access>read-write</access>
                </field>

                <field>
                    <name>AFE</name>
                    <bitRange>[5:5]</bitRange>
                    <description>Auto flow control enable.\n
          1: The auto-CTS and auto-RTS setting is based on the \n
RTS bit setting: \n
When RTS = 0, auto-CTS only \n
When RTS = 1, auto-CTS and auto-RTS \n

                    </description>
                    <access>read-write</access>
                </field>
            </fields>
        </register>
        <register>
            <name>LSR</name>
            <description>Line Status Register</description>
            <addressOffset>0x34</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
                <field>
                    <name>DR</name>
                    <bitRange>[0:0]</bitRange>
                    <description>Data Ready (DR) indicator.</description>
                    <access>read-only</access>
                </field>
                <field>
                    <name>OE</name>
                    <bitRange>[1:1]</bitRange>
                    <description>Overrun Error (OE) indicator</description>
                    <access>read-only</access>
                </field>
                <field>
                    <name>PE</name>
                    <bitRange>[2:2]</bitRange>
                    <description
                    >Out2. In loopback mode, connected to Data Carrier Detect (DCD)input.</description>
                    <access>read-only</access>
                </field>
                <field>
                    <name>FE</name>
                    <bitRange>[3:3]</bitRange>
                    <description>Framing Error (FE) indicator</description>
                    <access>read-only</access>
                </field>
                <field>
                    <name>LBreak</name>
                    <bitRange>[4:4]</bitRange>
                    <description>Line break</description>
                    <access>read-only</access>
                </field>
                <field>
                    <name>THRE</name>
                    <bitRange>[5:5]</bitRange>
                    <description>Transmit FIFO is empty.</description>
                    <access>read-only</access>
                </field>
                <field>
                    <name>TEMT</name>
                    <bitRange>[6:6]</bitRange>
                    <description>Transmitter Empty indicator.</description>
                    <access>read-only</access>
                </field>
                <field>
                    <name>ERRF</name>
                    <bitRange>[7:7]</bitRange>
                    <description>Error in RXFIFO</description>
                    <access>read-only</access>
                </field>
            </fields>
        </register>
        <register>
            <name>MSR</name>
            <description>Modem Status Register</description>
            <addressOffset>0x38</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
                <field>
                    <name>DCTS</name>
                    <bitRange>[0:0]</bitRange>
                    <description>Delta Clear To Send (DCTS) indicator\n
                       1: The CTS line has changed its state.
                    </description>
                    <access>read-only</access>
                </field>
                <field>
                    <name>DDSR</name>
                    <bitRange>[1:1]</bitRange>
                    <description>Delta Data Set Ready (DDSR) indicator\n
                      1: The DSR line has changed its state.</description>
                    <access>read-only</access>
                </field>
                <field>
                    <name>TERI</name>
                    <bitRange>[2:2]</bitRange>
                    <description
                    >Trailing Edge of Ring Indicator (TERI) detector. The RI line has \n
                       changed its state from low to high state.
                    </description>
                    <access>read-only</access>
                </field>
                <field>
                    <name>DDCD</name>
                    <bitRange>[3:3]</bitRange>
                    <description>Delta Data Carrier Detect (DDCD) indicator</description>
                    <access>read-only</access>
                </field>
                <field>
                    <name>CTS</name>
                    <bitRange>[4:4]</bitRange>
                    <description>Clear to send</description>
                    <access>read-only</access>
                </field>
                <field>
                    <name>DSR</name>
                    <bitRange>[5:5]</bitRange>
                    <description>Data set ready</description>
                    <access>read-only</access>
                </field>
                <field>
                    <name>RI</name>
                    <bitRange>[6:6]</bitRange>
                    <description>Ring indicator</description>
                    <access>read-only</access>
                </field>
                <field>
                    <name>DCD</name>
                    <bitRange>[7:7]</bitRange>
                    <description>Data carrier detect</description>
                    <access>read-only</access>
                </field>
            </fields>
        </register>

        <register>
            <name>SCR</name>
            <description>Scratch Register</description>
            <addressOffset>0x3C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
        </register>

        <register>
            <name>PSELCTSN</name>
            <description>CTSN pin select</description>
            <addressOffset>0x40</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
        </register>

        <register>
            <name>PSELDCDN</name>
            <description>DCDN pin select</description>
            <addressOffset>0x44</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
        </register>

        <register>
            <name>PSELDSRN</name>
            <description>DSRN pin select</description>
            <addressOffset>0x48</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
        </register>

        <register>
            <name>PSELRIN</name>
            <description>RIN pin select</description>
            <addressOffset>0x4C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
        </register>

        <register>
            <name>PSELSIN</name>
            <description>SIN pin select</description>
            <addressOffset>0x50</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
        </register>

        <register>
            <name>PSELDTRN</name>
            <description>DTRN pin select</description>
            <addressOffset>0x54</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
        </register>


        <register>
            <name>PSELOUT1N</name>
            <description>OUT1N pin select</description>
            <addressOffset>0x58</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
        </register>


        <register>
            <name>PSELOUT2N</name>
            <description>OUT2N pin select</description>
            <addressOffset>0x5C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
        </register>

        <register>
            <name>PSELRTSN</name>
            <description>RTSN pin select</description>
            <addressOffset>0x60</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
        </register>


        <register>
            <name>PSELSOUT</name>
            <description>SOUT pin select</description>
            <addressOffset>0x64</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
        </register>


    </registers>
</peripheral>
<peripheral>
  <name>SPI0</name>
  <version>1.0</version>
  <description>Quad Serial Peripheral Interface 0</description>
  <groupName>SPI0</groupName>
  <baseAddress>0x80002000</baseAddress>
  <size>32</size>
  <access>read-write</access>
  <addressBlock>
    <offset>0</offset>
    <size>0x1000</size>
    <usage>registers</usage>
  </addressBlock>
  <registers>
  
    <register>
      <name>TRANSCTRL</name>
      <description>SPI transfer control register
		 </description>
      <addressOffset>0x00</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFFFFFFFF</resetMask>
      <fields>
       
        <field>
          <name>RdTranCnt</name>
          <description>Transfer count for read data \n
RdTranCnt indicates the number of units of data to \n
be received from SPI bus and stored to the Data \n
Register. The actual received count is \n
(RdTranCnt+1). \n
RdTransCnt only takes effect when TransMode is \n
0, 2, 3, 4, 5, 6 or 9. \n
The size (bit-width) of a data unit is defined by the \n
DataLen field of the Transfer Format Register. \n
For TransMode 0, WrTranCnt must equal RdTranCnt.
          </description>
          <bitRange>[8:0]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>DummyCnt</name>
          <description>Dummy data count. The actual dummy count is \n
(DummyCnt +1). \n
The number of dummy cycles on the SPI interface \n
will be (DummyCnt+1)* ((DataLen+1)/SPI IO width) \n
The Data pins are put into the high impedance \n
during the dummy data phase. \n
DummyCnt is only used for TransMode 5, 6, 8 and 9, \n
which has dummy data phases.
          </description>
          <bitRange>[10:9]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>TokenValue</name>
          <description>Token value (Master mode only) \n
The value of the one-byte special token following the  \n
address phase for SPI read transfers.  \n
0x0: token value = 0x00  \n
0x1: token value = 0x69  \n
          </description>
          <bitRange>[11:11]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>WrTranCnt</name>
          <description>WrTranCnt indicates the number of units of data to \n
be transmitted to the SPI bus from the Data Register.  \n
The actual transfer count is (WrTranCnt+1).  \n
WrTranCnt only takes effect when TransMode is 0,  \n
1, 3, 4, 5, 6 or 8.  \n
The size (bit-width) of a data unit is defined by the  \n
DataLen field of the Transfer Format Register.  \n
For TransMode 0, WrTranCnt must be equal to  \n
RdTranCnt.
          </description>
          <bitRange>[20:12]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>TokenEn</name>
          <description>Token transfer enable (Master mode only) \n
Append an one-byte special token following the  \n
address phase for SPI read transfers. The value of the  \n
special token should be selected in TokenValue.  \n
0x0: Disable the one-byte special token  \n
0x1: Enable the one-byte special token
          </description>
          <bitRange>[21:21]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>DualQuad</name>
          <description>SPI data phase format \n
                      0x0: Regular (Single) mode \n
                      0x1: Dual I/O mode \n
                      0x2: Quad I/O mode \n
                      0x3: Reserved
          </description>
          <bitRange>[23:22]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>TransMode</name>
          <description>Transfer mode \n
                        The transfer sequence could be \n
                        0x0: Write and read at the same time \n
                        0x1: Write only \n
                        0x2: Read only \n
                        0x3: Write, Read \n
                        0x4: Read, Write \n
                        0x5: Write, Dummy, Read \n
                        0x6: Read, Dummy, Write \n
                        0x7: None Data (must enable CmdEn or AddrEn in master mode) \n
                        0x8: Dummy, Write \n
                        0x9: Dummy, Read \n
                       0xa~0xf: Reserved 
          </description>
          <bitRange>[27:24]</bitRange>
          <access>read-write</access>
        </field>
        
        <field>
          <name>AddrFmt</name>
          <description>SPI address phase format (Master mode only) \n
                       0x0: Address phase is the regular (single) mode  \n
                       0x1: The format of the address phase is the same as  \n
                            the data phase (DualQuad).
          </description>
          <bitRange>[28:28]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>AddrEn</name>
          <description>SPI address phase enable (Master mode only) \n
                       0x0: Disable the address phase \n
                       0x1: Enable the address phase
          </description>
          <bitRange>[29:29]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>CmdEn</name>
          <description>SPI command phase enable (Master mode only) \n
                       0x0: Disable the command phase \n
                       0x1: Enable the command phase
          </description>
          <bitRange>[30:30]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>SlvDataOnly</name>
          <description>Data-only mode (slave mode only) \n
                       0x0: Disable the data-only mode \n
                       0x1: Enable the data-only mode
          </description>
          <bitRange>[31:31]</bitRange>
          <access>read-write</access>
        </field>

      </fields>
    </register>
    
    <register>
      <name>CMD</name>
      <description>SPI command register</description>
      <addressOffset>0x04</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0x0FFFFFFF</resetMask>
      
    </register>
 
    <register>
      <name>ADDR</name>
      <description>SPI address register</description>
      <addressOffset>0x08</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFFFFFFFF</resetMask>
    </register>
   
    <register>
      <name>DATA</name>
      <description>SPI data register</description>
      <addressOffset>0x0C</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
    </register>
  
    <register>
      <name>CTRL</name>
      <description>SPI conrtol register</description>
      <addressOffset>0x10</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFFFFFFFF</resetMask>
       <fields>
      
        <field>
          <name>SPIRST</name>
          <description>
						SPI reset\n
          Write 1 to reset. It is automatically cleared to 0 after \n
          the reset operation completes.
          </description>
          <bitRange>[0:0]</bitRange>
          <access>read-write</access>
        </field>
  
        <field>
          <name>RXFIFORST</name>
          <description>Receive FIFO reset.\n
            Write 1 to reset. It is automatically cleared to 0 after \n
          the reset operation completes.
          </description>
          <bitRange>[1:1]</bitRange>
          <access>read-write</access>
        </field>
       
        <field>
          <name>TXFIFORST</name>
          <description>
						Transmit FIFO reset\n
						 Write 1 to reset. It is automatically cleared to 0 after \n
          the reset operation completes.
          </description>
          <bitRange>[2:2]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>RXDMAEN</name>
          <description>
						RX DMA enable
          </description>
          <bitRange>[3:3]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>TXDMAEN</name>
          <description>
						RX DMA enable
          </description>
          <bitRange>[4:4]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>RXTHRES</name>
          <description>
						Receive (RX) FIFO Threshold
          </description>
          <bitRange>[15:8]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>TXTHRES</name>
          <description>
						Transmit (TX) FIFO Threshold
          </description>
          <bitRange>[23:16]</bitRange>
          <access>read-write</access>
        </field>


      </fields>
    </register>
  
    <register>
      <name>STATUS</name>
      <description>SPI status register</description>
      <addressOffset>0x14</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0x3FFF</resetMask>
      <fields>
        
        <field>
          <name>SPIActive</name>
          <description>
						SPI register programming is in progress.\n
            In master mode, SPIActive becomes 1 after the SPI \n
command register is written and becomes 0 after the \n
transfer is finished. \n
In slave mode, SPIActive becomes 1 after the SPI \n
CS signal is asserted and becomes 0 after the SPI CS \n
signal is deasserted.
          </description>
          <bitRange>[0:0]</bitRange>
          <access>read-only</access>
        </field>
    
        

        <field>
          <name>RXEMPTY</name>
          <description>Receive FIFO Empty flag
          </description>
          <bitRange>[4:4]</bitRange>
           <access>read-only</access>
        </field>

         <field>
          <name>RXFULL</name>
          <description>Receive FIFO Full flag
          </description>
          <bitRange>[5:5]</bitRange>
           <access>read-only</access>
        </field>

        <field>
          <name>RXNUM</name>
          <description>Number of valid entries in the Receive FIFO
          </description>
          <bitRange>[15:8]</bitRange>
           <access>read-only</access>
        </field>

       

        <field>
          <name>TXEMPTY</name>
          <description>Transmit FIFO Empty flag
          </description>
          <bitRange>[16:16]</bitRange>
           <access>read-only</access>
        </field>

         <field>
          <name>TXFULL</name>
          <description>Transmit FIFO Full flag
          </description>
          <bitRange>[17:17]</bitRange>
           <access>read-only</access>
        </field>

          <field>
          <name>TXNUM</name>
          <description>Number of valid entries in the Transmit FIFO
          </description>
          <bitRange>[27:20]</bitRange>
           <access>read-only</access>
        </field>

        
       
      </fields>
    </register>


    <register>
      <name>INTREN</name>
      <description>SPI interrupt enable register</description>
      <addressOffset>0x18</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
      <fields>
    
        <field>
          <name>RXFIFOORIntEn</name>
          <description>Enable the SPI Receive FIFO Overrun interrupt.
          </description>
          <bitRange>[0:0]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>TXFIFOURIntEn</name>
          <description>Enable the SPI Transmit FIFO Underrun interrupt.
          </description>
          <bitRange>[1:1]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>RXFIFOIntEn</name>
          <description>Enable the SPI Receive FIFO Threshold interrupt.
          </description>
          <bitRange>[2:2]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>TXFIFOIntEn</name>
          <description>Enable the SPI Transmit FIFO Threshold interrupt.
          </description>
          <bitRange>[3:3]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>EndIntEn</name>
          <description>Enable the End of SPI Transfer interrupt.
          </description>
          <bitRange>[4:4]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>SlvCmdEn</name>
          <description>Enable the Slave Command Interrupt.
          </description>
          <bitRange>[5:5]</bitRange>
          <access>read-write</access>
        </field>

      </fields>
    </register>

    <register>
      <name>INTRST</name>
      <description>SPI interrupt status register</description>
      <addressOffset>0x1C</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
      <fields>
       
        <field>
          <name>RXFIFOORInt</name>
          <description>RX FIFO Overrun interrupt. (W1C)
          </description>
          <bitRange>[0:0]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>TXFIFOURInt</name>
          <description>TX FIFO Underrun interrupt. (W1C)
          </description>
          <bitRange>[1:1]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>RXFIFOInt</name>
          <description>RX FIFO Threshold interrupt. (W1C)
          </description>
          <bitRange>[2:2]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>TXFIFOInt</name>
          <description>TX FIFO Threshold interrupt. (W1C)
          </description>
          <bitRange>[3:3]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>EndInt</name>
          <description>End of SPI Transfer interrupt. (W1C)
          </description>
          <bitRange>[4:4]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>SlvCmdInt</name>
          <description>Slave Command Interrupt. (W1C)
          </description>
          <bitRange>[5:5]</bitRange>
          <access>read-write</access>
        </field>
      </fields>
    </register>

     <register>
      <name>TIMING</name>
      <description>SPI interface timing register</description>
      <addressOffset>0x20</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
      <fields>
       
        <field>
          <name>SCLK_DIV</name>
          <description>The clock frequency ratio between the clock source and SPI interface SCLK. \n
                      SCLK = ((SCLK_DIV+1) *2 )
          </description>
          <bitRange>[7:0]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>CSHT</name>
          <description>The minimum time that SPI CS should stay HIGH. Configuration The actual duration is \n
                      ( SCK peroid ) x (CSHT +1)
          </description>
          <bitRange>[11:8]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>CS2SCLK</name>
          <description>The minimum time between the edges of SPI CS and the edges of SCLK\n
                      ( SCK peroid /2) x (CS2SCLK +1)
          </description>
          <bitRange>[13:12]</bitRange>
          <access>read-write</access>
        </field>
      </fields>
    </register>

    <register>
      <name>TRANSFMT</name>
      <description>SPI transfer format register</description>
      <addressOffset>0x30</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
      <fields>
       
        <field>
          <name>CPHA</name>
          <description>SPI Clock Phase \n
                       0x0: SCLK is LOW in the idle states \n
                       0x1: SCLK is HIGH in the idle states
          </description>
          <bitRange>[0:0]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>CPOL</name>
          <description>SPI Clock Polarity\n
                       0x0: SCLK is LOW in the idle states \n
                       0x1: SCLK is HIGH in the idle states \n
          </description>
          <bitRange>[1:1]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>SlvMode</name>
          <description>SPI Master/Slave mode selection \n
                       0x0: Master mode \n
                       0x1: Slave mode \n
          </description>
          <bitRange>[2:2]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>LSB</name>
          <description>Transfer data with the least significant bit first \n
                       0x0: Most significant bit first \n
                       0x1: Least significant bit first
          </description>
          <bitRange>[3:3]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>MOSIBiDir</name>
          <description>Bi-directional MOSI in regular (single) mode \n
                       0x0: MOSI is uni-directional signal in regular mode. \n
                       0x1: MOSI is bi-directional signal in regular mode.
          </description>
          <bitRange>[4:4]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>DataMerge</name>
          <description>Enable Data Merge mode, which does automatic data \n
                       split on write and data coalescing on read.
          </description>
          <bitRange>[7:7]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>DataLen</name>
          <description>The length of each data unit in bits \n
                       The actual bit number of a data unit is (DataLen + 1)
          </description>
          <bitRange>[12:8]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>AddrLen</name>
          <description>Address length in bytes \n
                       0x0: 1 byte \n
                       0x1: 2 bytes \n
                       0x2: 3 bytes \n
                       0x3: 4 bytes
          </description>
          <bitRange>[17:16]</bitRange>
          <access>read-write</access>
        </field>
      </fields>
    </register>

    <register>
      <name>DIRECTIO</name>
      <description>SPI direct IO control register</description>
      <addressOffset>0x34</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
      <fields>
     
        <field>
          <name>CS_I</name>
          <description>Status of the SPI CS (chip select) signal
          </description>
          <bitRange>[0:0]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>SCLK_I</name>
          <description>Status of the SPI SCLK signal
          </description>
          <bitRange>[1:1]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>MOSI_I</name>
          <description>Status of the SPI MOSI signal
          </description>
          <bitRange>[2:2]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>MISO_I</name>
          <description>Status of the SPI MISO signal
          </description>
          <bitRange>[3:3]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>WP_I</name>
          <description>Status of the SPI Flash write protect signal
          </description>
          <bitRange>[4:4]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>HOLD_I</name>
          <description>Status of the SPI Flash hold signal
          </description>
          <bitRange>[5:5]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>CS_O</name>
          <description>Output value for the SPI CS (chip select) signal
          </description>
          <bitRange>[8:8]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>SCLK_O</name>
          <description>Output value for the SPI SCLK signal
          </description>
          <bitRange>[9:9]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>MOSI_O</name>
          <description>Output value for the SPI MOSI signal
          </description>
          <bitRange>[10:10]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>MISO_O</name>
          <description>Output value for the SPI MISO signal
          </description>
          <bitRange>[11:11]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>WP_O</name>
          <description>Output value for the SPI Flash write protect signal
          </description>
          <bitRange>[12:12]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>HOLD_O</name>
          <description>Output value for the SPI Flash hold signal
          </description>
          <bitRange>[13:13]</bitRange>
          <access>read-write</access>
        </field>


        <field>
          <name>CS_OE</name>
          <description>Output enable for the SPI CS (chip select) signal
          </description>
          <bitRange>[16:16]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>SCLK_OE</name>
          <description>Output enable for the SPI SCLK signal
          </description>
          <bitRange>[17:17]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>MOSI_OE</name>
          <description>Output enable for the SPI MOSI signal
          </description>
          <bitRange>[18:18]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>MISO_OE</name>
          <description>Output enable for the SPI MISO signal
          </description>
          <bitRange>[19:19]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>WP_OE</name>
          <description>Output enable for the SPI Flash write protect signal
          </description>
          <bitRange>[20:20]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>HOLD_OE</name>
          <description>Output enable for the SPI Flash hold signal
          </description>
          <bitRange>[21:21]</bitRange>
          <access>read-write</access>
        </field>
      </fields>
    </register>


    <register>
      <name>MEMCTRL</name>
      <description>SPI memory access control register</description>
      <addressOffset>0x40</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
      <fields>
        
        <field>
          <name>MemRdCmd</name>
          <description>Selects the SPI command for serving the \n
                       memory-mapped reads on the AHB/EILM bus \n
                       The command encoding table is listed in Table 
                       0: command : 0x03 \n
                       1: command : 0x0B \n
                       2: command : 0x3B \n
                       3: command : 0x6B \n
                       4: command : 0xBB \n
                       5: command : 0xEB \n
                       8: command : 0x13 \n
                       9: command : 0x0C \n
                      10: command : 0x3C \n
                      11: command : 0x6C \n
                      12: command : 0xBC \n
                      13: command : 0xEC \n

          
          </description>
          <bitRange>[3:0]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>MemCtrlChg</name>
          <description>This bit is set when this register (0x50) or the SPI \n
                       Interface Timing Register (0x40) is written; it is \n
                       automatically cleared when the new programming \n
                       takes effect.
          </description>
          <bitRange>[8:8]</bitRange>
          <access>read-only</access>
        </field>
      </fields>
    </register>

    <register>
      <name>SLVST</name>
      <description>SPI slave status register</description>
      <addressOffset>0x50</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
      <fields>
    
        <field>
          <name>USR_Status</name>
          <description>User defined status flags
          </description>
          <bitRange>[15:0]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Ready</name>
          <description>Set this bit to indicate  that the SPI is ready fordata transaction.
          </description>
          <bitRange>[16:16]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>OverRun</name>
          <description>Data overrun occurs in the last transaction
          </description>
          <bitRange>[17:17]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>UnderRun</name>
          <description>Data underrun occurs in the last transaction
          </description>
          <bitRange>[18:18]</bitRange>
          <access>read-write</access>
        </field>
      </fields>
    </register>

    <register>
      <name>SLVDATACNT</name>
      <description>SPI slave data count register</description>
      <addressOffset>0x54</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
      <fields>
      
        <field>
          <name>RCnt</name>
          <description>Slave received data count
          </description>
          <bitRange>[9:0]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>WCnt</name>
          <description>Slave received data count
          </description>
          <bitRange>[25:16]</bitRange>
          <access>read-only</access>
        </field>
      </fields>
    </register>

    <register>
      <name>PSELCLK</name>
      <description>CLK Pin Select register</description>
      <addressOffset>0x60</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
    </register>

    <register>
      <name>PSELCSN</name>
      <description>CSN Pin Select register</description>
      <addressOffset>0x64</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
    </register>

     <register>
      <name>PSELMOSI</name>
      <description>MOSI Pin Select register</description>
      <addressOffset>0x68</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
    </register>

    <register>
      <name>PSELMISO</name>
      <description>MISO Pin Select register</description>
      <addressOffset>0x6C</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
    </register>

    <register>
      <name>PSELWPN</name>
      <description>WPN Pin Select register</description>
      <addressOffset>0x70</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
    </register>

     <register>
      <name>PSELHOLDN</name>
      <description>HOLDN Pin Select register</description>
      <addressOffset>0x74</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
    </register>

    <register>
      <name>SPI_DS</name>
      <description>SPI Driving sel with DS0 – DS3</description>
      <addressOffset>0x78</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
    </register>

    <register>
      <name>CID</name>
      <description>SPI Component ID and Revision register</description>
      <addressOffset>0xFF0</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
    </register>

    <register>
      <name>PID</name>
      <description> SPI Peripheral ID register</description>
      <addressOffset>0xFF4</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
      <fields>
      
        <field>
          <name>RxFIFOSize </name>
          <description>Depth of RX FIFO \n
          0x0: 2 words \n
          0x1: 4 words  \n
          0x2: 8 words  \n
          0x3: 16 words  \n
          0x4: 32 words  \n
          0x5: 64 words  \n
          0x6: 128 words  
          </description>
          <bitRange>[3:0]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>TxFIFOSize</name>
          <description>Depth of TX FIFO \n
            0x0: 2 words \n
          0x1: 4 words  \n
          0x2: 8 words  \n
          0x3: 16 words  \n
          0x4: 32 words  \n
          0x5: 64 words  \n
          0x6: 128 words  
          </description>
          <bitRange>[7:4]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>DualSPI</name>
          <description>Support for Dual I/O SPI
          </description>
          <bitRange>[8:8]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>QuadSPI </name>
          <description>Support for Quad I/O SPI 
          </description>
          <bitRange>[9:9]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>DirectIO</name>
          <description>Support for Direct SPI IO 
          </description>
          <bitRange>[11:11]</bitRange>
          <access>read-only</access>
        </field>

          <field>
          <name>AHBMem</name>
          <description>Support for memory-mapped access (read-only) through AHB bus 
          </description>
          <bitRange>[12:12]</bitRange>
          <access>read-only</access>
        </field>

         <field>
          <name>EILMMem</name>
          <description>Support for memory-mapped access (read-only)  through EILM bus 
          </description>
          <bitRange>[13:13]</bitRange>
          <access>read-only</access>
        </field>

         <field>
          <name>Slave</name>
          <description>Support for SPI Slave mode 
          </description>
          <bitRange>[14:14]</bitRange>
          <access>read-only</access>
        </field>
      </fields>
    </register>
  </registers>
</peripheral>
<peripheral>
  <name>SPI1</name>
  <version>1.0</version>
  <description>Quad Serial Peripheral Interface 1</description>
  <groupName>SPI1</groupName>
  <baseAddress>0x8000C000</baseAddress>
  <size>32</size>
  <access>read-write</access>
  <addressBlock>
    <offset>0</offset>
    <size>0x1000</size>
    <usage>registers</usage>
  </addressBlock>
  <registers>
  
    <register>
      <name>TRANSCTRL</name>
      <description>SPI transfer control register
		 </description>
      <addressOffset>0x00</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFFFFFFFF</resetMask>
      <fields>
       
        <field>
          <name>RdTranCnt</name>
          <description>Transfer count for read data \n
RdTranCnt indicates the number of units of data to \n
be received from SPI bus and stored to the Data \n
Register. The actual received count is \n
(RdTranCnt+1). \n
RdTransCnt only takes effect when TransMode is \n
0, 2, 3, 4, 5, 6 or 9. \n
The size (bit-width) of a data unit is defined by the \n
DataLen field of the Transfer Format Register. \n
For TransMode 0, WrTranCnt must equal RdTranCnt.
          </description>
          <bitRange>[8:0]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>DummyCnt</name>
          <description>Dummy data count. The actual dummy count is \n
(DummyCnt +1). \n
The number of dummy cycles on the SPI interface \n
will be (DummyCnt+1)* ((DataLen+1)/SPI IO width) \n
The Data pins are put into the high impedance \n
during the dummy data phase. \n
DummyCnt is only used for TransMode 5, 6, 8 and 9, \n
which has dummy data phases.
          </description>
          <bitRange>[10:9]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>TokenValue</name>
          <description>Token value (Master mode only) \n
The value of the one-byte special token following the  \n
address phase for SPI read transfers.  \n
0x0: token value = 0x00  \n
0x1: token value = 0x69  \n
          </description>
          <bitRange>[11:11]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>WrTranCnt</name>
          <description>WrTranCnt indicates the number of units of data to \n
be transmitted to the SPI bus from the Data Register.  \n
The actual transfer count is (WrTranCnt+1).  \n
WrTranCnt only takes effect when TransMode is 0,  \n
1, 3, 4, 5, 6 or 8.  \n
The size (bit-width) of a data unit is defined by the  \n
DataLen field of the Transfer Format Register.  \n
For TransMode 0, WrTranCnt must be equal to  \n
RdTranCnt.
          </description>
          <bitRange>[20:12]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>TokenEn</name>
          <description>Token transfer enable (Master mode only) \n
Append an one-byte special token following the  \n
address phase for SPI read transfers. The value of the  \n
special token should be selected in TokenValue.  \n
0x0: Disable the one-byte special token  \n
0x1: Enable the one-byte special token
          </description>
          <bitRange>[21:21]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>DualQuad</name>
          <description>SPI data phase format \n
                      0x0: Regular (Single) mode \n
                      0x1: Dual I/O mode \n
                      0x2: Quad I/O mode \n
                      0x3: Reserved
          </description>
          <bitRange>[23:22]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>TransMode</name>
          <description>Transfer mode \n
                        The transfer sequence could be \n
                        0x0: Write and read at the same time \n
                        0x1: Write only \n
                        0x2: Read only \n
                        0x3: Write, Read \n
                        0x4: Read, Write \n
                        0x5: Write, Dummy, Read \n
                        0x6: Read, Dummy, Write \n
                        0x7: None Data (must enable CmdEn or AddrEn in master mode) \n
                        0x8: Dummy, Write \n
                        0x9: Dummy, Read \n
                       0xa~0xf: Reserved 
          </description>
          <bitRange>[27:24]</bitRange>
          <access>read-write</access>
        </field>
        
        <field>
          <name>AddrFmt</name>
          <description>SPI address phase format (Master mode only) \n
                       0x0: Address phase is the regular (single) mode  \n
                       0x1: The format of the address phase is the same as  \n
                            the data phase (DualQuad).
          </description>
          <bitRange>[28:28]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>AddrEn</name>
          <description>SPI address phase enable (Master mode only) \n
                       0x0: Disable the address phase \n
                       0x1: Enable the address phase
          </description>
          <bitRange>[29:29]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>CmdEn</name>
          <description>SPI command phase enable (Master mode only) \n
                       0x0: Disable the command phase \n
                       0x1: Enable the command phase
          </description>
          <bitRange>[30:30]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>SlvDataOnly</name>
          <description>Data-only mode (slave mode only) \n
                       0x0: Disable the data-only mode \n
                       0x1: Enable the data-only mode
          </description>
          <bitRange>[31:31]</bitRange>
          <access>read-write</access>
        </field>

      </fields>
    </register>
    
    <register>
      <name>CMD</name>
      <description>SPI command register</description>
      <addressOffset>0x04</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0x0FFFFFFF</resetMask>
      
    </register>
 
    <register>
      <name>ADDR</name>
      <description>SPI address register</description>
      <addressOffset>0x08</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFFFFFFFF</resetMask>
    </register>
   
    <register>
      <name>DATA</name>
      <description>SPI data register</description>
      <addressOffset>0x0C</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
    </register>
  
    <register>
      <name>CTRL</name>
      <description>SPI conrtol register</description>
      <addressOffset>0x10</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFFFFFFFF</resetMask>
       <fields>
      
        <field>
          <name>SPIRST</name>
          <description>
						SPI reset\n
          Write 1 to reset. It is automatically cleared to 0 after \n
          the reset operation completes.
          </description>
          <bitRange>[0:0]</bitRange>
          <access>read-write</access>
        </field>
  
        <field>
          <name>RXFIFORST</name>
          <description>Receive FIFO reset.\n
            Write 1 to reset. It is automatically cleared to 0 after \n
          the reset operation completes.
          </description>
          <bitRange>[1:1]</bitRange>
          <access>read-write</access>
        </field>
       
        <field>
          <name>TXFIFORST</name>
          <description>
						Transmit FIFO reset\n
						 Write 1 to reset. It is automatically cleared to 0 after \n
          the reset operation completes.
          </description>
          <bitRange>[2:2]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>RXDMAEN</name>
          <description>
						RX DMA enable
          </description>
          <bitRange>[3:3]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>TXDMAEN</name>
          <description>
						RX DMA enable
          </description>
          <bitRange>[4:4]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>RXTHRES</name>
          <description>
						Receive (RX) FIFO Threshold
          </description>
          <bitRange>[15:8]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>TXTHRES</name>
          <description>
						Transmit (TX) FIFO Threshold
          </description>
          <bitRange>[23:16]</bitRange>
          <access>read-write</access>
        </field>


      </fields>
    </register>
  
    <register>
      <name>STATUS</name>
      <description>SPI status register</description>
      <addressOffset>0x14</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0x3FFF</resetMask>
      <fields>
        
        <field>
          <name>SPIActive</name>
          <description>
						SPI register programming is in progress.\n
            In master mode, SPIActive becomes 1 after the SPI \n
command register is written and becomes 0 after the \n
transfer is finished. \n
In slave mode, SPIActive becomes 1 after the SPI \n
CS signal is asserted and becomes 0 after the SPI CS \n
signal is deasserted.
          </description>
          <bitRange>[0:0]</bitRange>
          <access>read-only</access>
        </field>
    
        

        <field>
          <name>RXEMPTY</name>
          <description>Receive FIFO Empty flag
          </description>
          <bitRange>[4:4]</bitRange>
           <access>read-only</access>
        </field>

         <field>
          <name>RXFULL</name>
          <description>Receive FIFO Full flag
          </description>
          <bitRange>[5:5]</bitRange>
           <access>read-only</access>
        </field>

        <field>
          <name>RXNUM</name>
          <description>Number of valid entries in the Receive FIFO
          </description>
          <bitRange>[15:8]</bitRange>
           <access>read-only</access>
        </field>

       

        <field>
          <name>TXEMPTY</name>
          <description>Transmit FIFO Empty flag
          </description>
          <bitRange>[16:16]</bitRange>
           <access>read-only</access>
        </field>

         <field>
          <name>TXFULL</name>
          <description>Transmit FIFO Full flag
          </description>
          <bitRange>[17:17]</bitRange>
           <access>read-only</access>
        </field>

          <field>
          <name>TXNUM</name>
          <description>Number of valid entries in the Transmit FIFO
          </description>
          <bitRange>[27:20]</bitRange>
           <access>read-only</access>
        </field>

        
       
      </fields>
    </register>


    <register>
      <name>INTREN</name>
      <description>SPI interrupt enable register</description>
      <addressOffset>0x18</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
      <fields>
    
        <field>
          <name>RXFIFOORIntEn</name>
          <description>Enable the SPI Receive FIFO Overrun interrupt.
          </description>
          <bitRange>[0:0]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>TXFIFOURIntEn</name>
          <description>Enable the SPI Transmit FIFO Underrun interrupt.
          </description>
          <bitRange>[1:1]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>RXFIFOIntEn</name>
          <description>Enable the SPI Receive FIFO Threshold interrupt.
          </description>
          <bitRange>[2:2]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>TXFIFOIntEn</name>
          <description>Enable the SPI Transmit FIFO Threshold interrupt.
          </description>
          <bitRange>[3:3]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>EndIntEn</name>
          <description>Enable the End of SPI Transfer interrupt.
          </description>
          <bitRange>[4:4]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>SlvCmdEn</name>
          <description>Enable the Slave Command Interrupt.
          </description>
          <bitRange>[5:5]</bitRange>
          <access>read-write</access>
        </field>

      </fields>
    </register>

    <register>
      <name>INTRST</name>
      <description>SPI interrupt status register</description>
      <addressOffset>0x1C</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
      <fields>
       
        <field>
          <name>RXFIFOORInt</name>
          <description>RX FIFO Overrun interrupt. (W1C)
          </description>
          <bitRange>[0:0]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>TXFIFOURInt</name>
          <description>TX FIFO Underrun interrupt. (W1C)
          </description>
          <bitRange>[1:1]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>RXFIFOInt</name>
          <description>RX FIFO Threshold interrupt. (W1C)
          </description>
          <bitRange>[2:2]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>TXFIFOInt</name>
          <description>TX FIFO Threshold interrupt. (W1C)
          </description>
          <bitRange>[3:3]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>EndInt</name>
          <description>End of SPI Transfer interrupt. (W1C)
          </description>
          <bitRange>[4:4]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>SlvCmdInt</name>
          <description>Slave Command Interrupt. (W1C)
          </description>
          <bitRange>[5:5]</bitRange>
          <access>read-write</access>
        </field>
      </fields>
    </register>

     <register>
      <name>TIMING</name>
      <description>SPI interface timing register</description>
      <addressOffset>0x20</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
      <fields>
       
        <field>
          <name>SCLK_DIV</name>
          <description>The clock frequency ratio between the clock source and SPI interface SCLK. \n
                      SCLK = ((SCLK_DIV+1) *2 )
          </description>
          <bitRange>[7:0]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>CSHT</name>
          <description>The minimum time that SPI CS should stay HIGH. Configuration The actual duration is \n
                      ( SCK peroid ) x (CSHT +1)
          </description>
          <bitRange>[11:8]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>CS2SCLK</name>
          <description>The minimum time between the edges of SPI CS and the edges of SCLK\n
                      ( SCK peroid /2) x (CS2SCLK +1)
          </description>
          <bitRange>[13:12]</bitRange>
          <access>read-write</access>
        </field>
      </fields>
    </register>

    <register>
      <name>TRANSFMT</name>
      <description>SPI transfer format register</description>
      <addressOffset>0x30</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
      <fields>
       
        <field>
          <name>CPHA</name>
          <description>SPI Clock Phase \n
                       0x0: SCLK is LOW in the idle states \n
                       0x1: SCLK is HIGH in the idle states
          </description>
          <bitRange>[0:0]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>CPOL</name>
          <description>SPI Clock Polarity\n
                       0x0: SCLK is LOW in the idle states \n
                       0x1: SCLK is HIGH in the idle states \n
          </description>
          <bitRange>[1:1]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>SlvMode</name>
          <description>SPI Master/Slave mode selection \n
                       0x0: Master mode \n
                       0x1: Slave mode \n
          </description>
          <bitRange>[2:2]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>LSB</name>
          <description>Transfer data with the least significant bit first \n
                       0x0: Most significant bit first \n
                       0x1: Least significant bit first
          </description>
          <bitRange>[3:3]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>MOSIBiDir</name>
          <description>Bi-directional MOSI in regular (single) mode \n
                       0x0: MOSI is uni-directional signal in regular mode. \n
                       0x1: MOSI is bi-directional signal in regular mode.
          </description>
          <bitRange>[4:4]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>DataMerge</name>
          <description>Enable Data Merge mode, which does automatic data \n
                       split on write and data coalescing on read.
          </description>
          <bitRange>[7:7]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>DataLen</name>
          <description>The length of each data unit in bits \n
                       The actual bit number of a data unit is (DataLen + 1)
          </description>
          <bitRange>[12:8]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>AddrLen</name>
          <description>Address length in bytes \n
                       0x0: 1 byte \n
                       0x1: 2 bytes \n
                       0x2: 3 bytes \n
                       0x3: 4 bytes
          </description>
          <bitRange>[17:16]</bitRange>
          <access>read-write</access>
        </field>
      </fields>
    </register>

    <register>
      <name>DIRECTIO</name>
      <description>SPI direct IO control register</description>
      <addressOffset>0x34</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
      <fields>
     
        <field>
          <name>CS_I</name>
          <description>Status of the SPI CS (chip select) signal
          </description>
          <bitRange>[0:0]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>SCLK_I</name>
          <description>Status of the SPI SCLK signal
          </description>
          <bitRange>[1:1]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>MOSI_I</name>
          <description>Status of the SPI MOSI signal
          </description>
          <bitRange>[2:2]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>MISO_I</name>
          <description>Status of the SPI MISO signal
          </description>
          <bitRange>[3:3]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>WP_I</name>
          <description>Status of the SPI Flash write protect signal
          </description>
          <bitRange>[4:4]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>HOLD_I</name>
          <description>Status of the SPI Flash hold signal
          </description>
          <bitRange>[5:5]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>CS_O</name>
          <description>Output value for the SPI CS (chip select) signal
          </description>
          <bitRange>[8:8]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>SCLK_O</name>
          <description>Output value for the SPI SCLK signal
          </description>
          <bitRange>[9:9]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>MOSI_O</name>
          <description>Output value for the SPI MOSI signal
          </description>
          <bitRange>[10:10]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>MISO_O</name>
          <description>Output value for the SPI MISO signal
          </description>
          <bitRange>[11:11]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>WP_O</name>
          <description>Output value for the SPI Flash write protect signal
          </description>
          <bitRange>[12:12]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>HOLD_O</name>
          <description>Output value for the SPI Flash hold signal
          </description>
          <bitRange>[13:13]</bitRange>
          <access>read-write</access>
        </field>


        <field>
          <name>CS_OE</name>
          <description>Output enable for the SPI CS (chip select) signal
          </description>
          <bitRange>[16:16]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>SCLK_OE</name>
          <description>Output enable for the SPI SCLK signal
          </description>
          <bitRange>[17:17]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>MOSI_OE</name>
          <description>Output enable for the SPI MOSI signal
          </description>
          <bitRange>[18:18]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>MISO_OE</name>
          <description>Output enable for the SPI MISO signal
          </description>
          <bitRange>[19:19]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>WP_OE</name>
          <description>Output enable for the SPI Flash write protect signal
          </description>
          <bitRange>[20:20]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>HOLD_OE</name>
          <description>Output enable for the SPI Flash hold signal
          </description>
          <bitRange>[21:21]</bitRange>
          <access>read-write</access>
        </field>
      </fields>
    </register>


    <register>
      <name>MEMCTRL</name>
      <description>SPI memory access control register</description>
      <addressOffset>0x40</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
      <fields>
        
        <field>
          <name>MemRdCmd</name>
          <description>Selects the SPI command for serving the \n
                       memory-mapped reads on the AHB/EILM bus \n
                       The command encoding table is listed in Table 
                       0: command : 0x03 \n
                       1: command : 0x0B \n
                       2: command : 0x3B \n
                       3: command : 0x6B \n
                       4: command : 0xBB \n
                       5: command : 0xEB \n
                       8: command : 0x13 \n
                       9: command : 0x0C \n
                      10: command : 0x3C \n
                      11: command : 0x6C \n
                      12: command : 0xBC \n
                      13: command : 0xEC \n

          
          </description>
          <bitRange>[3:0]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>MemCtrlChg</name>
          <description>This bit is set when this register (0x50) or the SPI \n
                       Interface Timing Register (0x40) is written; it is \n
                       automatically cleared when the new programming \n
                       takes effect.
          </description>
          <bitRange>[8:8]</bitRange>
          <access>read-only</access>
        </field>
      </fields>
    </register>

    <register>
      <name>SLVST</name>
      <description>SPI slave status register</description>
      <addressOffset>0x50</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
      <fields>
    
        <field>
          <name>USR_Status</name>
          <description>User defined status flags
          </description>
          <bitRange>[15:0]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Ready</name>
          <description>Set this bit to indicate  that the SPI is ready fordata transaction.
          </description>
          <bitRange>[16:16]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>OverRun</name>
          <description>Data overrun occurs in the last transaction
          </description>
          <bitRange>[17:17]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>UnderRun</name>
          <description>Data underrun occurs in the last transaction
          </description>
          <bitRange>[18:18]</bitRange>
          <access>read-write</access>
        </field>
      </fields>
    </register>

    <register>
      <name>SLVDATACNT</name>
      <description>SPI slave data count register</description>
      <addressOffset>0x54</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
      <fields>
      
        <field>
          <name>RCnt</name>
          <description>Slave received data count
          </description>
          <bitRange>[9:0]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>WCnt</name>
          <description>Slave received data count
          </description>
          <bitRange>[25:16]</bitRange>
          <access>read-only</access>
        </field>
      </fields>
    </register>

    <register>
      <name>PSELCLK</name>
      <description>CLK Pin Select register</description>
      <addressOffset>0x60</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
    </register>

    <register>
      <name>PSELCSN</name>
      <description>CSN Pin Select register</description>
      <addressOffset>0x64</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
    </register>

     <register>
      <name>PSELMOSI</name>
      <description>MOSI Pin Select register</description>
      <addressOffset>0x68</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
    </register>

    <register>
      <name>PSELMISO</name>
      <description>MISO Pin Select register</description>
      <addressOffset>0x6C</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
    </register>

    <register>
      <name>PSELWPN</name>
      <description>WPN Pin Select register</description>
      <addressOffset>0x70</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
    </register>

     <register>
      <name>PSELHOLDN</name>
      <description>HOLDN Pin Select register</description>
      <addressOffset>0x74</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
    </register>

     <register>
      <name>SPI_DS</name>
      <description>SPI Driving sel with DS0 – DS3</description>
      <addressOffset>0x78</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
    </register>

    <register>
      <name>CID</name>
      <description>SPI Component ID and Revision register</description>
      <addressOffset>0xFF0</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
    </register>

    <register>
      <name>PID</name>
      <description> SPI Peripheral ID register</description>
      <addressOffset>0xFF4</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFF</resetMask>
      <fields>
      
        <field>
          <name>RxFIFOSize </name>
          <description>Depth of RX FIFO \n
          0x0: 2 words \n
          0x1: 4 words  \n
          0x2: 8 words  \n
          0x3: 16 words  \n
          0x4: 32 words  \n
          0x5: 64 words  \n
          0x6: 128 words  
          </description>
          <bitRange>[3:0]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>TxFIFOSize</name>
          <description>Depth of TX FIFO \n
            0x0: 2 words \n
          0x1: 4 words  \n
          0x2: 8 words  \n
          0x3: 16 words  \n
          0x4: 32 words  \n
          0x5: 64 words  \n
          0x6: 128 words  
          </description>
          <bitRange>[7:4]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>DualSPI</name>
          <description>Support for Dual I/O SPI
          </description>
          <bitRange>[8:8]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>QuadSPI </name>
          <description>Support for Quad I/O SPI 
          </description>
          <bitRange>[9:9]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>DirectIO</name>
          <description>Support for Direct SPI IO 
          </description>
          <bitRange>[11:11]</bitRange>
          <access>read-only</access>
        </field>

          <field>
          <name>AHBMem</name>
          <description>Support for memory-mapped access (read-only) through AHB bus 
          </description>
          <bitRange>[12:12]</bitRange>
          <access>read-only</access>
        </field>

         <field>
          <name>EILMMem</name>
          <description>Support for memory-mapped access (read-only)  through EILM bus 
          </description>
          <bitRange>[13:13]</bitRange>
          <access>read-only</access>
        </field>

         <field>
          <name>Slave</name>
          <description>Support for SPI Slave mode 
          </description>
          <bitRange>[14:14]</bitRange>
          <access>read-only</access>
        </field>
      </fields>
    </register>
  </registers>
</peripheral>
<peripheral>
  <name>I2C</name>
  <version>1.0</version>
  <description>I2C</description>
  <groupName>I2C</groupName>
  <baseAddress>0x80004000</baseAddress>
  <size>32</size>
  <access>read-write</access>
  <addressBlock>
    <offset>0</offset>
    <size>0x1000</size>
    <usage>registers</usage>
  </addressBlock>
 
  <registers>
  
    
   <register>
      <name>Cmd</name>
      <description>Write this register with the following values to perform \n
                    the corresponding actions: \n
                    0x0: no action \n
                    0x1: issue a data transaction (Master only) \n
                    0x2: respond with an ACK to the received byte \n
                    0x3: respond with a NACK to the received byte \n
                    0x4: clear the FIFO  \n
                    0x5: reset the I 2 C controller abort current transaction, set \n
                         the SDA and SCL line to the open-drain mode, reset the \n
                         Status Register and the Interrupt Enable Register, and empty\n
                         the FIFO When issuing a data transaction by writing 0x1 to this \n
                        register, the CMD field stays at 0x1 for the duration of the \n
                        entire transaction, and it is only cleared to 0x0 after when \n
                        the transaction has completed or when the controller loses \n
                        the arbitration. \n
                        Note: No transaction will be issued by the controller when \n
                        all phases (Start, Address, Data and Stop) are disabled.</description>
      <addressOffset>0x00</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
    </register>
   
     <register>
      <name>Addr</name>
      <description>Address Register\n
                   For 7-bit addressing mode, the most significant 3 bits are ignored and only the least-significant 7 bits of Addr are valid.\n</description>
      <addressOffset>0x04</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue> 
    </register>
   
    <register>
      <name>Data</name>
      <description>Data Register</description>
      <addressOffset>0x08</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
    </register>

     <register>
      <name>Ctrl</name>
      <description>Control Register</description>
      <addressOffset>0x0C</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
       <fields>
        <field>
          <name>DataCnt</name>
          <description>Data counts in bytes. \n
                   Master: The number of bytes to transmit/receive. 0 means \n
                           256 bytes. DataCnt will be decreased by one for each byte
                            transmitted/received. \n
                    Slave: the meaning of DataCnt depends on the DMA
           </description>
          <bitRange>[7:0]</bitRange>
          <access>read-write</access>
        </field>


         <field>
          <name>Dir</name>
          <description>Transaction direction \n
                        Master: Set this bit to determine the direction for the next transaction. \n
                                    0: Transmitter \n
                                    1: Receiver \n
                        Slave: The direction of the last received transaction. \n
                                    0: Receiver \n
                                    1: Transmitter \n
           </description>
          <bitRange>[8:8]</bitRange>
          <access>read-write</access>
        </field>


          <field>
          <name>Phase_stop</name>
          <description>Enable this bit to send a STOP condition at the end of a transaction. \n 
                       Master mode only.
           </description>
          <bitRange>[9:9]</bitRange>
          <access>read-write</access>
        </field>


         <field>
          <name>Phase_data</name>
          <description>Enable this bit to send the data after Address phase. \n
                      Master mode only.
           </description>
          <bitRange>[10:10]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>Phase_addr</name>
          <description>Enable this bit to send the address after START condition. \n
                      Master mode only.
           </description>
          <bitRange>[11:11]</bitRange>
          <access>read-write</access>
        </field>

          <field>
          <name>Phase_start</name>
          <description>Enable this bit to send a START condition at the\n
                      beginning of transaction. \n
                      Master mode only.
           </description>
          <bitRange>[12:12]</bitRange>
          <access>read-write</access>
        </field>


        </fields>
    </register>

  
    <register>
      <name>IntEn</name>
      <description>Interrupt Enable Register</description>
      <addressOffset>0x10</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>FIFOEmpty</name>
          <description>
						Set to enable the FIFO Empty Interrupt.
					</description>
          <bitRange>[0:0]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>FIFOFull</name>
          <description>
						Set to enable the FIFO Full Interrupt.
					</description>
          <bitRange>[1:1]</bitRange>
          <access>read-write</access>
        </field>

          <field>
          <name>FIFOHalf</name>
          <description>
					Set to enable the FIFO Half Interrupt Receiver: Interrupts when the FIFO is half-full,
          i.e. there \n
is more then 1/2 entries in the FIFO. \n
Transmitter: Interrupts when the FIFO is half-empty, i.e. \n
there is less then 1/2 entries in the FIFO. \n
This interrupt depends on the transaction direction ; dont \\n
enable this interrupt unless the transfer direction is \n
determined, otherwise unintended interrupts may be \n
triggered.
					</description>
          <bitRange>[2:2]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>AddrHit</name>
          <description>
						Set to enable the Address Hit Interrupt. \n
            Master: interrupts when the addressed slave returned an ACK. \n
            Slave: interrupts when the controller is addressed. 
					</description>
          <bitRange>[3:3]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>ArbLose</name>
          <description>
					Set to enable the Arbitration Lose Interrupt. \n 
           Master: interrupts when the controller loses the bus
arbitration \n
          Slave: not available in this mode \n
					</description>
          <bitRange>[4:4]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>Stop</name>
          <description>
						Set to enable the STOP Condition Interrupt.
					</description>
          <bitRange>[5:5]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>Start</name>
          <description>
						Set to enable the START Condition Interrupt.
					</description>
          <bitRange>[6:6]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>ByteTrans</name>
          <description>
						Set to enable the Byte Transmit Interrupt.
					</description>
          <bitRange>[7:7]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>ByteRecv</name>
          <description>
				  Set to enable the Byte Receive Interrupt. \n
          Interrupts when a byte of data is received \n
          Auto-ACK will be disabled if this interrupt is enabled, that \n
          is, the software needs to ACK/NACK the received byte \n
          manually.
					</description>
          <bitRange>[8:8]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>Cmpl</name>
          <description>
				  Set to enable the Completion Interrupt. \n
Master: interrupts when a transaction is issued from this \n
master and completed without losing the bus arbitration. \n
Slave: interrupts when a transaction addressing the \n
controller is completed. \n
					</description>
          <bitRange>[9:9]</bitRange>
          <access>read-write</access>
        </field>
       
      </fields>
    </register>
  
    <register>
      <name>Status</name>
      <description>Status Register</description>
      <addressOffset>0x14</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>FIFOEmpty</name>
          <description>Indicates that the FIFO is empty.</description>
          <bitRange>[0:0]</bitRange>
          <access>read-only</access>
        </field>
        
        <field>
          <name>FIFOFull</name>
          <description>Indicates that the FIFO is full.</description>
          <bitRange>[1:1]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>FIFOHalf</name>
          <description>Transmitter: Indicates that the FIFO is half-empty.\n
                       Receiver: Indicates that the FIFO is half-full.
           </description>
          <bitRange>[2:2]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>AddrHit</name>
          <description>Master: indicates that a slave has responded to the transaction. \n
                       Slave: indicates that a transaction is targeting the controller (including the General Call). \n
                       write 1 clear the bit
           </description>
          <bitRange>[3:3]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>ArbLose</name>
          <description>Indicates that the controller has lost the bus arbitration \n
                       write 1 clear the bit
           </description>
          <bitRange>[4:4]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>Stop</name>
          <description>Indicates that a STOP Condition has been transmitted/received. \n
                       write 1 clear the bit
           </description>
          <bitRange>[5:5]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>Start</name>
          <description>Indicates that a START Condition or a repeated START \n
                        condition has been transmitted/received. \n
                       write 1 clear the bit
           </description>
          <bitRange>[6:6]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>ByteTrans</name>
          <description>Indicates that a byte of data has been transmitted. \n
                       write 1 clear the bit
           </description>
          <bitRange>[7:7]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>ByteRecv</name>
          <description>Indicates that a byte of data has been received. \n
                       write 1 clear the bit
           </description>
          <bitRange>[8:8]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>Cmpl</name>
          <description>Transaction Completion \n
                      Master: Indicates that a transaction has been issued \n
                               from this master and completed without losing the bus arbitration. \n
                      Slave: Indicates that a transaction addressing the \n
                             controller has been completed. This status bit must be  \n
                             cleared to receive the next transaction; otherwise, the \n
                             next incoming transaction will be blocked. \n
                       write 1 clear the bit \n
           </description>
          <bitRange>[9:9]</bitRange>
          <access>read-write</access>
        </field>

        <field>
          <name>ACK</name>
          <description>Indicates the type of the last received/transmitted \n
                     1: ACK \n
                     0: NACK
           </description>
          <bitRange>[10:10]</bitRange>
          <access>read-only</access>
        </field>

         <field>
          <name>BusBusy</name>
          <description>Indicates that the bus is busy.\n
                     1: Busy \n
                     0: Not busy
           </description>
          <bitRange>[11:11]</bitRange>
          <access>read-only</access>
        </field>

         <field>
          <name>GenCall</name>
          <description>Indicates that the address of the current transaction is a
general call address. \n This status is only valid in slave mode.\n
                     1: General call \n
                     0: Not general call
           </description>
          <bitRange>[12:12]</bitRange>
          <access>read-only</access>
        </field>

         <field>
          <name>LineSCL</name>
          <description>Indicates the current status of the SCL line on the bus. \n
                     1: High \n
                     0: Low
           </description>
          <bitRange>[13:13]</bitRange>
          <access>read-only</access>
        </field>

        <field>
          <name>LineSDA</name>
          <description>Indicates the current status of the SDA line on the bus. \n
                     1: High \n
                     0: Low
           </description>
          <bitRange>[14:14]</bitRange>
          <access>read-only</access>
        </field>

        
      </fields>
    </register>
  
   
     
    <register>
      <name>Cfg</name>
      <description>Configuration Register</description>
      <addressOffset>0x18</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <fields>
        <field>
          <name>FIFOSize</name>
          <description>
								FIFO size: \n
								0: 2 bytes \n
								1: 4 bytes \n
								2: 8 bytes \n
                3: 16 bytes
					</description>
          <bitRange>[1:0]</bitRange>
          <access>read-write</access>
        </field>
      </fields>
    </register>

      <register>
      <name>Setup</name>
      <description>Setup Register</description>
      <addressOffset>0x1C</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
          <fields>
             <field>
                <name>IICEn</name>
                <description>Enable the ATCIIC100 I 2 C controller. \n
                      1: Enable \n
                      0: Disable
                </description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
            </field>

            <field>
                <name>Addressing</name>
                <description>I2C addressing mode: \n
                      1: 10-bit addressing mode
                      0: 7-bit addressing mode
                </description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
            </field>

            <field>
                <name>Master</name>
                <description>Configure this device as a master or a slave.: \n
                      1: Master mode \n
                      0: Slave mode
                </description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
            </field>

            <field>
                <name>DMAEn</name>
                <description>Enable the direct memory access mode data transfer.: \n
                     1: Enable \n
                      0: Disable \n
                </description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
            </field>

             <field>
                <name>T_SCLHi</name>
                <description>The HIGH period of generated SCL clock is defined by
T_SCLHi.
SCL HIGH period = (2 * t pclk ) + (2 + T_SP + T_SCLHi) *
t pclk * (TPM+1)
The T_SCLHi value must be greater than T_SP and
T_HDDAT values.
This field is only valid when the controller is in the
master mode.
                </description>
                <bitRange>[12:4]</bitRange>
                <access>read-write</access>
            </field>

            <field>
                <name>T_SCLRatio</name>
                <description>The LOW period of the generated SCL clock is defined by 0x1
the combination of T_SCLRatio and T_SCLHi values.
When T_SCLRatio = 0, the LOW period is equal to
HIGH period. When T_SCLRatio = 1, the LOW period is
roughly two times of HIGH period.
SCL LOW period = (2 * t pclk ) + (2 + T_SP + T_SCLHi *
ratio) * t pclk * (TPM+1)
1: ratio = 2
0: ratio = 1
This field is only valid when the controller is in the
master mode
                </description>
                <bitRange>[13:13]</bitRange>
                <access>read-write</access>
            </field>

            <field>
                <name>T_HDDAT</name>
                <description>T_HDDAT defines the data hold time after SCL goes \n
                            Hold time = (2 * tpclk) + (2 + T_SP + T_HDDAT) * tpclk * (TPM+1)


                </description>
                <bitRange>[20:16]</bitRange>
                <access>read-write</access>
            </field>

             <field>
                <name>T_SP</name>
                <description>T_SP defines the pulse width of spikes that must be\n
                    suppressed by the input filter.Pulse width = T_SP * tpclk * (TPM+1)

                </description>
                <bitRange>[23:21]</bitRange>
                <access>read-write</access>
            </field>
            
             <field>
                <name>T_SUDAT</name>
                <description>T_SUDAT defines the data setup time before releasing the SCL \n
                            Setup time = (2 * tpclk) + (2 + T_SP + T_SUDAT) * tpclk*(TPM+1) \n
                            tpclk= PCLK period \n
                            TPM = The multiplier value in Timing Parameter Multiplier Register \n

                </description>
                <bitRange>[28:24]</bitRange>
                <access>read-write</access>
            </field>
        </fields>
    </register>

      <register>
      <name>TPM</name>
      <description>I2C Timing Parameter Multiplier Register</description>
      <addressOffset>0x20</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
    </register>

     <register>
      <name>SCLPINSEL</name>
      <description>I2C SCL pinsel Register</description>
      <addressOffset>0x24</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
    </register>

     <register>
      <name>SDAPINSEL</name>
      <description>I2C SDA pinsel Register</description>
      <addressOffset>0x28</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
    </register>

    <register>
      <name>CID</name>
      <description>I2C Component ID and Revision Register</description>
      <addressOffset>0xFF0</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x0000FFFF</resetValue>
    </register>


     <register>
      <name>PID</name>
      <description>Product </description>
      <addressOffset>0xFF4</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      
    </register>
  </registers>
</peripheral>
<peripheral>
  <name>PWM</name>
  <version>1.0</version>
  <description>Programmable Interval Timer (PIT)</description>
  <groupName>PWM</groupName>
  <baseAddress>0x80005000</baseAddress>
  <size>32</size>
  <access>read-write</access>
  <addressBlock>
    <offset>0</offset>
    <size>0x1000</size>
    <usage>registers</usage>
  </addressBlock>
  
  <registers>

   
    <register>
      <name>Cfg</name>
      <description>Number of PIT channels</description>
      <addressOffset>0x00</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFFFFFFFF</resetMask>
    </register>

   

    <register>
      <name>IntEn</name>
      <description>Interrupt Enable Register
      </description>
      <addressOffset>0x04</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0xFFFFFFFF</resetMask>
       <fields>
        <field>
          <name>Ch0Int0En</name>
          <description>Channel 0 Timer 0 interrupt enable</description>
          <bitRange>[0:0]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Ch0Int1En</name>
          <description>Channel 0 Timer 1 interrupt enable</description>
          <bitRange>[1:1]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Ch0Int2En</name>
          <description>Channel 0 Timer 2 interrupt enable</description>
          <bitRange>[2:2]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Ch0Int3En</name>
          <description>Channel 0 Timer 3 interrupt enable</description>
          <bitRange>[3:3]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>Ch1Int0En</name>
          <description>Channel 1 Timer 0 interrupt enable</description>
          <bitRange>[4:4]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Ch1Int1En</name>
          <description>Channel 1 Timer 1 interrupt enable</description>
          <bitRange>[5:5]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Ch1Int2En</name>
          <description>Channel 1 Timer 2 interrupt enable</description>
          <bitRange>[6:6]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Ch1Int3En</name>
          <description>Channel 1 Timer 3 interrupt enable</description>
          <bitRange>[7:7]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>Ch2Int0En</name>
          <description>Channel 2 Timer 0 interrupt enable</description>
          <bitRange>[8:8]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>Ch2Int1En</name>
          <description>Channel 2 Timer 1 interrupt enable</description>
          <bitRange>[9:9]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>Ch2Int2En</name>
          <description>Channel 2 Timer 2 interrupt enable</description>
          <bitRange>[10:10]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>Ch2Int3En</name>
          <description>Channel 2 Timer 3 interrupt enable</description>
          <bitRange>[11:11]</bitRange>
          <access>read-write</access>
        </field>

         <field>
          <name>Ch3Int0En</name>
          <description>Channel 3 Timer 0 interrupt enable</description>
          <bitRange>[12:12]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Ch3Int1En</name>
          <description>Channel 3 Timer 1 interrupt enable</description>
          <bitRange>[13:13]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>Ch3Int2En</name>
          <description>Channel 3 Timer 2 interrupt enable</description>
          <bitRange>[14:14]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>Ch3Int3En</name>
          <description>Channel 3 Timer 3 interrupt enable</description>
          <bitRange>[15:15]</bitRange>
          <access>read-write</access>
        </field>

       </fields>
    </register>
  


     <register>
      <name>IntSt</name>
      <description>Interrupt Status Register</description>
      <addressOffset>0x08</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <fields>
        <field>
          <name>Ch0Int0</name>
          <description>Channel 0 Timer 0 interrupt status</description>
          <bitRange>[0:0]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Ch0Int1</name>
          <description>Channel 0 Timer 1 interrupt status</description>
          <bitRange>[1:1]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Ch0Int2</name>
          <description>Channel 0 Timer 2 interrupt status</description>
          <bitRange>[2:2]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Ch0Int3</name>
          <description>Channel 0 Timer 3 interrupt status</description>
          <bitRange>[3:3]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>Ch1Int0</name>
          <description>Channel 1 Timer 0 interrupt status</description>
          <bitRange>[4:4]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Ch1Int1</name>
          <description>Channel 1 Timer 1 interrupt status</description>
          <bitRange>[5:5]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Ch1Int2</name>
          <description>Channel 1 Timer 2 interrupt status</description>
          <bitRange>[6:6]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Ch1Int3</name>
          <description>Channel 1 Timer 3 interrupt status</description>
          <bitRange>[7:7]</bitRange>
          <access>read-write</access>
        </field>
         <field>
          <name>Ch2Int0</name>
          <description>Channel 2 Timer 0 interrupt status</description>
