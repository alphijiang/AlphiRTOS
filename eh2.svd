</peripheral>
<peripheral>
    <name>IGZO_REG0</name>
    <version>1.0</version>
    <description>IGZO APB register</description>
    <groupName>IGZO</groupName>
    <baseAddress>0x8000A000</baseAddress>
    <size>32</size>
    <access>read-write</access>
    <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
    </addressBlock>
    <registers>

        <register>
            <name>IGZO_CTRL</name>
            <description>
                IGZO Control Register
            </description>
            <addressOffset>0x00</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
                <field>
                    <name>GDAC_OUT1</name>
                    <description
                    >Write 1 to clear all the gate driver output data to 1 , ignored when GDAC_OUT0 = 0</description>
                    <bitRange>[29:29]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>GDAC_OUT0</name>
                    <description
                    >Write 1 to clear all the gate data to 0</description>
                    <bitRange>[28:28]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>YADC_MASK_DATA</name>
                    <description
                    >YADC  3 bits LSB mask data mask data for ADC result DATA LSB 3 bits if corresponding YADC_MASK_BITS[x] = 1</description>
                    <bitRange>[26:24]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>YADC_MASK_BITS</name>
                    <description
                    >YADC enable LSB mask bits mask enable for ADC result LSB</description>
                    <bitRange>[22:20]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>YADC_EN_INT8_NS</name>
                    <description
                    >YADC enable int8 no shift, only be active as YADC_EN_INT8 = 1 and YADC_RAW_READ = 0 \n
                      if YADC_EN_INT8_NS = 0   \n
                              YADC_result = adc_out[8:1]\n
                      if YADC_EN_INT8_NS = 1 \n
                              If adc_out [8] != adc_out[7]  then Underflow or overflow \n
                                   YADC_result = {8{adc_out[8]}}  or  YADC_result = {adc_out[8], adc_out[6:0]}
                    </description>
                    <bitRange>[18:18]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>YADC_EN_INT8</name>
                    <description
                    >YADC enable int8, only be active when YADC_RAW_READ = 0\n
                     1: YADC result data is treated as a 8-bit positve integer data\n
                     0: YADC result data output = adc_out[7:0]
                    </description>
                    <bitRange>[17:17]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>YADC_RAW_READ</name>
                    <description>
            YADC enable raw read\n
            1. Direct read the YADC raw data for YADC result data\n
            0: YADC result data is processed by YADC_EN_INT8/YADC_EN_INT8_NS.\n
            Note that if YADC_RAW_READ = 1, each YADC result data will be 9 bits , i.e. 2bytes for each data.\n
            if YADC_RAW_READ = 0\n
                   YADC result data will be 8bits, i.e. 1 byte
                    </description>
                    <bitRange>[16:16]</bitRange>
                    <access>read-write</access>
                </field>
                 <field>
                    <name>SAR_RED</name>
                    <description>SAR Logic redundant function</description>
                    <bitRange>[14:14]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>SAR_RELU</name>
                    <description>SAR Logic RELU function</description>
                    <bitRange>[13:13]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>BYPASS_RELU</name>
                    <description>Bypass_RELU setting for IGZO</description>
                    <bitRange>[12:12]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>XDAC_CUR</name>
                    <description
                    >X data buffer current Set Xdriver internal buffer, 0 to buffer 0 and 1 to buffer1</description>
                    <bitRange>[11:11]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>XDAC_TOGGLE</name>
                    <description
                    >X data buffer auto toggle Auto toggel the buffer for X Driver</description>
                    <bitRange>[10:10]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>XDAC_OUT1</name>
                    <description
                    >Write 1 to clear all the 512 X driver data to (0xFF), inactive when XDAC_OUT0 = 1</description>
                    <bitRange>[9:9]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>XDAC_OUT0</name>
                    <description
                    >Write 1 to clear all the 512 X driver data output to (0x00), </description>
                    <bitRange>[8:8]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>WDAC_EN_INT8_NS</name>
                    <description>
        No shift left (x2) for DAC input, only active when WDAC_EN_INT8 = 1 and WDAC_EN_DIRECT_MAP = 0\n
        0 :   WDATA[n] is defined as 2's complement value
        1:    convert WDATA[n] to 2's complement value to unsigned value, but when -128(0xFF), it will become 255\n

        when WDATA[n] is positve value,\n
               i.e. bit7 = 0     wdac[2n*8+7  :2n*8     ] = {WDATA[6:0], 0}     wdac[2n*8+15:2n*8+8] = 0\n
        when WDATA[n] is negative value, i.e. bit7 = 1     wdac[2n*8+7  :2n*8     ] = 0     wdac[2n*8+15:2n*8+8] = {~WDATA[6:0], and WDATA[6:0]}
                    </description>
                    <bitRange>[4:4]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>WDAC_EN_INT8</name>
                    <description>
        Enable int 8 mode, only active when WDAC_EN_DIRECT_MAP = 0 \n
        1: WDATA[n] is defined as a signed integer\n
           if bit 7 = 0, indicate a positive data\n
           if bit7 = 1, indicate a negative data\n
           WDATA[n] indicate a signed integer, and wdac[2n*8+7:2n*8]\n
           wdac[(2n*8+15):2n*8+8] is defined by single WDATA[n]
                    </description>
                    <bitRange>[3:3]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>WDAC_EN_DIRECT_MAP</name>
                    <description
                    >Weight DATA 0x8001_0000~0x8001_0x1FF mapping mode\n
                     1: Direct mapping mode\n
                        WDATA[n] = wdac[n*8+:0]
                     0. Signed interger mapping mode:\n
                        WDATA[n] is defined as a signed integer and convert to wdac[n*16+8: n*16] and wdac [n*16+15:n*16+8]
                    </description>
                    <bitRange>[2:2]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>WDAC_OUT1</name>
                    <description
                    >Write 1 to clear all the 512 weight data for MAC to 0xFF, inactive when WDAC_OUT0 = 1</description>
                    <bitRange>[1:1]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>WDAC_OUT0</name>
                    <description
                    >Write 1 to clear all the 512 weight data for MAC to 0x0</description>
                    <bitRange>[0:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>XDAC_PRG</name>
            <description>XDAC program value when auto program mode</description>
            <addressOffset>0x04</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
        </register>



        <register>
            <name>CLK_CTRL</name>
            <addressOffset>0x08</addressOffset>
            <description>Clock Control Register</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>
                <field>
                    <name>CLK_DIV</name>
                    <description
                    >Clock divide value for IGZO auto program mode</description>
                    <bitRange>[31:16]</bitRange>
                    <access>read-write</access>
                </field>

                <field>
                    <name>CLK_EN</name>
                    <description
                    >Clock enable for IGZO auto program mode</description>
                    <bitRange>[0:0]</bitRange>
                    <access>read-write</access>
                </field>

            </fields>
        </register>

        <register>
            <name>YADC_EN[%s]</name>
            <addressOffset>0x20</addressOffset>
            <description>Enable ADC bit, n=address[5:0]*8</description>
            <size>8</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <dim>32</dim>
            <dimIncrement>1</dimIncrement>
        </register>

        <register>
            <name>IGZO_PRG_CTRL</name>
            <addressOffset>0x40</addressOffset>
            <description>ADC Control Register0</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>

                <field>
                    <name>IGZO_OP_MODE</name>
                    <description>IGZO operation mode select\n
                                 0: IGZO Write mode (WDAC program mode)\n
                                 1: IGZO Read mode (Inference mode) \n
                                 Only be active when MAC_EN = 1
                    </description>
                    <bitRange>[8:8]</bitRange>
                    <access>read-write</access>
                </field>

                <field>
                    <name>IGZO_CTRL_MD</name>
                    <description>0: CPU control Mode \n
                        1: Auto control Mode(Weight Data program mode/Inference mode)\n</description>
                    <bitRange>[0:0]</bitRange>
                    <access>read-write</access>
                </field>

            </fields>
        </register>


        <register>
            <name>ADC_CTRL1</name>
            <addressOffset>0x44</addressOffset>
            <description>ADC Control Register1</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>
                <field>
                    <name>YADC_PH3</name>
                    <description>YADC PH3</description>
                    <bitRange>[24:24]</bitRange>
                    <access>read-write</access>
                </field>

                <field>
                    <name>YADC_PH2</name>
                    <description>YADC PH2</description>
                    <bitRange>[16:16]</bitRange>
                    <access>read-write</access>
                </field>

                <field>
                    <name>YADC_GO</name>
                    <description>YADC Go signal</description>
                    <bitRange>[8:8]</bitRange>
                    <access>read-write</access>
                </field>

                <field>
                    <name>YADC_CLK</name>
                    <description>YADC Clock</description>
                    <bitRange>[0:0]</bitRange>
                    <access>read-write</access>
                </field>

            </fields>
        </register>

        <register>
            <name>ADC_CTRL2</name>
            <addressOffset>0x48</addressOffset>
            <description>ADC Control Register2</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>
                <field>
                    <name>CAPTURE_REQ</name>
                    <description>Capture ADC request</description>
                    <bitRange>[0:0]</bitRange>
                    <access>read-write</access>
                </field>

            </fields>
        </register>

        <register>
            <name>ADC_CTRL3</name>
            <addressOffset>0x4C</addressOffset>
            <description>ADC Control Register3</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>

                 <field>
                    <name>AUTO_CTRL_INT_STUS</name>
                    <description>
                        Write:\n
                            0: NOP\n
                           1: Clear Interrupt\n
                        Read:\n
                            0: Interrupt is inactive\n
                            1: Interrupt is active
                    </description>
                    <bitRange>[9:9]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>AUTO_CTRL_INT_EN</name>
                    <description>
                         0: Disable interrupt\n
                         1: Enable Interrupt
                     </description>
                    <bitRange>[8:8]</bitRange>
                    <access>read-write</access>
                </field>

                <field>
                    <name>AUTO_CTRL_START</name>
                    <description>
                        Write:\n
                            0: NOP\n
                            1:Launch the IGZO auto read/write program mode.\n
                            According to IGZO_RW_MODE setting \n
                            IGZO_RW_MODE = 0: IGZO auto write (WDAC program) mode \n
                            IGZO_RW_MODE = 1: IGZO auto read (inference) mode \n
                        Read:\n
                            0: IGZO auto program mode is finished\n
                            1: IGZO auto program mode is progressing\n
                            Only be active when IGZO_PRG_MD=1
                    </description>
                    <bitRange>[0:0]</bitRange>
                    <access>read-write</access>
                </field>

            </fields>
        </register>

        <register>
            <name>WDAC_AUTO_PRG_CFG0</name>
            <addressOffset>0x50</addressOffset>
            <description>ADC Control Register2</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>
                <field>
                    <name>cfg_wdac_prg_cycle</name>
                    <description
                    >Define the gate driver cycle count for each gate</description>
                    <bitRange>[15:0]</bitRange>
                    <access>read-write</access>
                </field>

            </fields>
        </register>

        <register>
            <name>WDAC_AUTO_PRG_CFG1</name>
            <addressOffset>0x54</addressOffset>
            <description>ADC Control Register2</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>
                <field>
                    <name>cfg_wdac_gate_fall</name>
                    <description
                    >DDefine the gate driver falling time for each gate</description>
                    <bitRange>[31:16]</bitRange>
                    <access>read-write</access>
                </field>

                <field>
                    <name>cfg_wdac_gate_rise</name>
                    <description
                    >DDefine the gate driver rising time for each gate</description>
                    <bitRange>[15:0]</bitRange>
                    <access>read-write</access>
                </field>

            </fields>
        </register>

        <register>
            <name>ADC_CTRL_CONFIG0</name>
            <addressOffset>0x58</addressOffset>
            <description>ADC Control Config Register 0</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>
                <field>
                    <name>cfg_adc_post_read_cycle</name>
                    <description>adjust timing</description>
                    <bitRange>[31:16]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>cfg_adc_pre_read_cycle</name>
                    <description>adjust timing</description>
                    <bitRange>[15:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>ADC_CTRL_CONFIG1</name>
            <addressOffset>0x5C</addressOffset>
            <description>ADC Control Config Register 1</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>
                <field>
                    <name>cfg_adc_sub_read_cycle</name>
                    <description>adjust timing</description>
                    <bitRange>[15:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>ADC_CTRL_CONFIG2</name>
            <addressOffset>0x60</addressOffset>
            <description>ADC Control Config Register 2</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>
                <field>
                    <name>cfg_adc_go_fall_at_total</name>
                    <description>adjust timing</description>
                    <bitRange>[19:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>ADC_CTRL_CONFIG3</name>
            <addressOffset>0x64</addressOffset>
            <description>ADC Control Config Register 3</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>
                <field>
                    <name>cfg_adc_go_rise_at_total</name>
                    <description>adjust timing</description>
                    <bitRange>[19:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>ADC_CTRL_CONFIG4</name>
            <addressOffset>0x68</addressOffset>
            <description>ADC Control Config Register 4</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>
                <field>
                    <name>cfg_adc_clk_fall_at_sub</name>
                    <description>adjust timing</description>
                    <bitRange>[31:16]</bitRange>
                    <access>read-write</access>
                </field>

                <field>
                    <name>cfg_adc_clk_rise_at_sub</name>
                    <description>adjust timing</description>
                    <bitRange>[15:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>ADC_CTRL_CONFIG5</name>
            <addressOffset>0x6C</addressOffset>
            <description>ADC Control Config Register 5</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>
                <field>
                    <name>cfg_adc_ph2_fall_at_sub</name>
                    <description>adjust timing</description>
                    <bitRange>[31:16]</bitRange>
                    <access>read-write</access>
                </field>

                <field>
                    <name>cfg_adc_ph2_rise_at_sub</name>
                    <description>adjust timing</description>
                    <bitRange>[15:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>ADC_CTRL_CONFIG6</name>
            <addressOffset>0x70</addressOffset>
            <description>ADC Control Config Register 6</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>
                <field>
                    <name>cfg_adc_ph3_fall_at_sub</name>
                    <description>adjust timing</description>
                    <bitRange>[31:16]</bitRange>
                    <access>read-write</access>
                </field>

                <field>
                    <name>cfg_adc_ph3_rise_at_sub</name>
                    <description>adjust timing</description>
                    <bitRange>[15:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>ADC_CTRL_CONFIG7</name>
            <addressOffset>0x74</addressOffset>
            <description>ADC Control Config Register 7</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>

                <field>
                    <name>cfg_adc_capture_at_total</name>
                    <description>adjust timing</description>
                    <bitRange>[19:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>SAR_LOGIC_CYCLE</name>
            <addressOffset>0x78</addressOffset>
            <description>ADC cycle</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>

                <field>
                    <name>sar_logic_cycle</name>
                    <description>Number of clk/ph2/ph3 in igzo mac</description>
                    <bitRange>[4:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>AUTO_PRG_CTRL0</name>
            <addressOffset>0x80</addressOffset>
            <description>IGZO auto WDAC program control register 0</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>

                <field>
                    <name>WDAC_SADDR</name>
                    <description
                    >Define the weight array by size of X*Y for auto program mode,\n
                        WDAC_SADDR defines the starting address for the array in the memory.\n
                        IGZO controller will write weight data from internal SRAM to IGZO memory.
                    </description>
                    <bitRange>[31:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>AUTO_PRG_CTRL1</name>
            <addressOffset>0x84</addressOffset>
            <description>IGZO auto WDAC program control register 1</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>
                 <field>
                    <name>WDAC_AXIS_Y_NO</name>
                    <description>
                        Define the weight array by size of X*Y for auto program mode,\n
                        WDAC_AXIS_Y_NO defines the Y(row number) of weight array. \n
                        IGZO controller will read weight data from internal SRAM and write them to IGZO memory
                    </description>
                    <bitRange>[24:16]</bitRange>
                    <access>read-write</access>
                </field>

                <field>
                    <name>WDAC_AXIS_X_BYTE_NO</name>
                    <description>
           Define the weight array by size of X*Y for auto program mode,\n
           WDAC_AXIS_X_BYTE_NO defines the X(column number) of the weight array.\n
           IGZO controller will read weight data from internal SRAM and write to IGZO memory
                    </description>
                    <bitRange>[8:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>AUTO_INF_CTRL0</name>
            <addressOffset>0x88</addressOffset>
            <description
            >IGZO auto inference mode control register 0</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>

                <field>
                    <name>XDAC_SADDR</name>
                    <description>
            Starting Address of internal RAM, which mapping to the XDAC data for auto inference mode.\n
            IGZO controller will read X data from SRAM according to AUTO_INF_CTRL1 setting each time,\n
            then assemble a complete 512 bytes XDATA to IGZO XDAC driver for auto inference.
                    </description>
                    <bitRange>[31:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>AUTO_INF_CTRL1</name>
            <addressOffset>0x8C</addressOffset>
            <description
            >IGZO auto inference mode control register 1</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>

                <field>
                    <name>XDAC_SIZE_IN_BYTE</name>
                    <description>
                Define the XDAC data valid block for inference when IGZO auto inference mode. \n
                Other data of out valid block will be set as 0, The register define the size (byte number) of the valid block.
                    </description>
                    <bitRange>[24:16]</bitRange>
                    <access>read-write</access>
                </field>

                <field>
                    <name>XDAC_START_BYTE</name>
                    <description
                    >Define the XDAC data valid block for inference when IGZO auto inference mode.\n
                     Other data of out valid block will be set as 0, The register defines the starting position in byte of the valid block.
                    </description>
                    <bitRange>[8:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>



        <register>
            <name>MAC_TEST_CTRL</name>
            <addressOffset>0x90</addressOffset>
            <description>MAC test control register</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>

                <field>
                    <name>MAC_TEST_EN</name>
                    <description>MAC_TEST enable</description>
                    <bitRange>[24:24]</bitRange>
                    <access>read-write</access>
                </field>

                <field>
                    <name>MAC_TEST_OUT</name>
                    <description>MAC_TEST output</description>
                    <bitRange>[23:16]</bitRange>
                    <access>read-only</access>
                </field>

                <field>
                    <name>MAC_TEST_IN</name>
                    <description>MAC_TEST input</description>
                    <bitRange>[15:0]</bitRange>
                    <access>read-write</access>
                </field>

            </fields>
        </register>

        <register>
            <name>MAC_REG_CLK_CTRL</name>
            <addressOffset>0x94</addressOffset>
            <description>chip stacking control register</description>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>

                <field>
                    <name>AUTO_MODE_OPTION</name>
                    <description>0: Disable Noise Reduction in Auto Prog mode. \n
                                 1: Enable Noise Reduction in Auto Prog mode.
                    </description>
                    <bitRange>[16:16]</bitRange>
                    <access>read-write</access>
                </field>

                <field>
                    <name>CFG_ACLK_G_EN</name>
                    <description>0: close clock enable (xdac,wdac,yadc)\n
                                  1: open clock enable
                    </description>
                    <bitRange>[0:0]</bitRange>
                    <access>read-write</access>
                </field>

            </fields>
        </register>

         <register>
            <name>MAC_TYPE_REG</name>
            <addressOffset>0x98</addressOffset>
            <description>IGZO AiMC type register</description>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0x00000000</resetMask>
            <fields>

                <field>
                    <name>MAC_TYPE</name>
                    <description>0: Syntronix AiMC array \n
                                 1: SEL AiMC array idea_01,  \n 
                                 2: SEL AiMC array idea_03,  \n
                                 3: SEL AiMC array idea_04,  \n
                                 4: PSMC AiMC array 
                    </description>
                    <bitRange>[2:0]</bitRange>
                    <access>read-only</access>
                </field>

               

            </fields>
        </register>

    </registers>
</peripheral>
<peripheral>
  <name>IGZO_REG1</name>
  <version>1.0</version>
  <description>IGZO AXI Register</description>
  <groupName>IGZO</groupName>
  <baseAddress>0x80010000</baseAddress>
  <size>32</size>
  <access>read-write</access>
  <addressBlock>
    <offset>0</offset>
    <size>0x1000</size>
    <usage>registers</usage>
  </addressBlock>
  <registers>

  <register>
      <name>WDATA[%s]</name>
      <description>Weight DATA buffer for IGZO controller\n
                   total 512 bytes (0x200), n=Address[8:0]
</description>
      <addressOffset>0x000</addressOffset>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0x00000000</resetMask>
      <dim>512</dim>
			<dimIncrement>1</dimIncrement>

</register>

  <register>
      <name>XDATA[%s]</name>
      <description>X DATA buffer for IGZO controller,\n
                   total 512 bytes (0x200), n=Address[8:0]
</description>
      <addressOffset>0x400</addressOffset>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0x00000000</resetMask>
      <dim>512</dim>
		<dimIncrement>1</dimIncrement>
  </register>

    <register>
        <name>YDATA16[%s]</name>
        <addressOffset>0x800</addressOffset>
		<description>YADC result output data\n
                     total 256 bytes, n=Address[8:1]
        </description>
        <size>16</size>
        <access>read-write</access>
        <resetValue>0x00000000</resetValue>
        <resetMask>0x00000000</resetMask>
        <dim>256</dim>
		<dimIncrement>2</dimIncrement>
    </register>

    <register>
        <name>YDATA8[%s]</name>
        <addressOffset>0x800</addressOffset>
		<description>YADC result output data\n
                     total 256 bytes, n=Address[8:1]
        </description>
        <size>8</size>
        <access>read-write</access>
        <resetValue>0x00000000</resetValue>
        <resetMask>0x00000000</resetMask>
        <dim>256</dim>
		<dimIncrement>1</dimIncrement>
    </register>

  <register>
      <name>GDATA[%s]</name>
      <addressOffset>0xC00</addressOffset>
		<description> total 512 bits, n = Address[5:3]*8</description>
      <size>8</size>
      <access>read-write</access>
      <resetValue>0x00000000</resetValue>
      <resetMask>0x00000000</resetMask>
      <dim>64</dim>
		<dimIncrement>1</dimIncrement>
  </register>

  </registers>
</peripheral>
<peripheral>
    <name>OPI</name>
    <version>1.0</version>
    <description>OPI Register</description>
    <groupName>OPI</groupName>
    <baseAddress>0x800B0000</baseAddress>
    <size>32</size>
    <access>read-write</access>
    <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
    </addressBlock>
    <registers>

        <register>
            <name>OPI_CMD</name>
            <description>OPI Command Register</description>
            <addressOffset>0x00</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
                <field>
                    <name>write_cmd</name>
                    <description>for APMEMORY sync write=0x00</description>
                    <bitRange>[15:8]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>read_cmd</name>
                    <description>for APMEMORY sync read=0x00</description>
                    <bitRange>[7:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>OPI_RST_SET</name>
            <description>OPI Reset Register</description>
            <addressOffset>0x04</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
                <field>
                    <name>rstn_wait_cyc</name>
                    <description>when using cmd reset ,determine how many cycles to delay (default 3+ bit [3:2])</description>
                    <bitRange>[3:2]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>rstn_done</name>
                    <description>1: reset complete ; 0:reset in process</description>
                    <bitRange>[1:1]</bitRange>
                    <access>read-only</access>
                </field>
                <field>
                    <name>rstn_en</name>
                    <description>active high pullse to initiate reset ; returns to 0 after 1 clock</description>
                    <bitRange>[0:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>TIMEING_SETTING</name>
            <description>OPI Timing setting Register</description>
            <addressOffset>0x08</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
                <field>
                    <name>tRST</name>
                    <description>for 50MHz(2us)</description>
                    <bitRange>[31:24]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>tRP</name>
                    <description>for 50MHz(1us)</description>
                    <bitRange>[23:16]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>tPU</name>
                    <description>for 50MHz(150us)</description>
                    <bitRange>[15:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>LATENCY_CYCLE</name>
            <description>OPI latency cycle Register</description>
            <addressOffset>0x0C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
                <field>
                    <name>wlc_cyc</name>
                    <description>write latency cycle</description>
                    <bitRange>[7:4]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>rlc_cyc</name>
                    <description>read latency cycle</description>
                    <bitRange>[3:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>CHIP_STACKING</name>
            <description>chip stacking Register</description>
            <addressOffset>0x10</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
                <field>
                    <name>stack_pe</name>
                    <description>determines whether the PAD of the data and dqs of the OPI needs to be pull enable \n
                                 1 : pull enable (nonstacking)\n
                                 0: pull desable (stacking)
                    </description>
                    <bitRange>[0:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>

        <register>
            <name>CLOCK_TIMING</name>
            <description>clock timing Register</description>
            <addressOffset>0x14</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
                <field>
                    <name>recive_clk_sel</name>
                    <description>determines whether the PAD of the data  dqs of the OPI needs to be pull enable\n
                                  1 : pull enable (nonstacking)  0: pull desable (stacking)
                    </description>
                    <bitRange>[31:31]</bitRange>
                    <access>read-write</access>
                </field>
                <field>
                    <name>clk_div</name>
                    <description>controls opi to apsram  CLK FREQ , must more than 1 .\n OPI_CLK=APB_CLK/(clk_div+1)
                    </description>
                    <bitRange>[15:0]</bitRange>
                    <access>read-write</access>
                </field>
            </fields>
        </register>
        <register>
            <name>IO_DRIVING</name>
            <description>IO driving Register</description>
            <addressOffset>0x18</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
                <field>
                    <name>opi_ce_ds</name>
                    <description>controls PAD driving strength\n
                                00 4mA\n
                                01: 8mA\n 
                                10: 16mA\n 
                                11: 24mA
                    </description>
                    <bitRange>[7:6]</bitRange>
                    <access>read-write</access>
                </field>

                <field>
                    <name>opi_dq_ds</name>
                    <description>controls PAD driving strength\n
                                00 4mA\n
                                01: 8mA\n 
                                10: 16mA\n 
                                11: 24mA
                    </description>
                    <bitRange>[5:4]</bitRange>
                    <access>read-write</access>
                </field>

                <field>
                    <name>opi_dmdqs_ds</name>
                    <description>controls PAD driving strength\n
                                00 4mA\n
                                01: 8mA\n 
                                10: 16mA\n 
                                11: 24mA
                    </description>
                    <bitRange>[3:2]</bitRange>
                    <access>read-write</access>
                </field>

                <field>
                    <name>opi_clk_ds</name>
                    <description>controls PAD driving strength\n
                                00 4mA\n
                                01: 8mA\n 
                                10: 16mA\n 
                                11: 24mA
                        </description>
                        <bitRange>[1:0]</bitRange>
                        <access>read-write</access>
                    </field>
                </fields>
            </register>


        </registers>
    </peripheral>
  </peripherals>
</device>
