    <!--   PULLUP:      Set GPIO Pull-Up register -->
    <register>
      <name>PE_LOW_SET</name>
      <description>Pull select:\n	
				 bit[pin*2] : 1: pullup , 0 : pulldownn
                 bit[pin*2+1]: enable
	</description>
      <addressOffset>0x50</addressOffset>
      <size>32</size>
      <access>read-write</access>
      <resetValue>0x0000FFFF</resetValue>
      <resetMask>0xFFFFFFFF</resetMask>
      <fields>
        <field>
          <name>Pin0</name>
          <description>bit0: 1: pullup,0:pulldown\n
                       bit1: 1: enable
           </description>
          <bitRange>[1:0]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Pin1</name>
          <description>bit2: 1: pullup,0:pulldown\n
                       bit3: 1: enable</description>
          <bitRange>[3:2]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Pin2</name>
          <description>bit4: 1: pullup,0:pulldown\n
                       bit5: 1: enable</description>
          <bitRange>[5:4]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Pin3</name>
          <description>bit6: 1: pullup,0:pulldown\n
                       bit7: 1: enable</description>
          <bitRange>[7:6]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Pin4</name>
          <description>bit8: 1: pullup,0:pulldown\n
                       bit9: 1: enable</description>
          <bitRange>[9:8]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Pin5</name>
          <description>bit10: 1: pullup,0:pulldown\n
                       bit11: 1: enable
          </description>
          <bitRange>[11:10]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Pin6</name>
          <description>bit12: 1: pullup,0:pulldown\n
                       bit13: 1: enable
          </description>
          <bitRange>[13:12]</bitRange>
          <access>read-write</access>
        </field>
        <field>
          <name>Pin7</name>
         <description>bit14: 1: pullup,0:pulldown\n
                      bit15: 1: enable
          </description>
          <bitRange>[15:14]</bitRange>
          <access>read-write</access>
        </field>
      </fields>
    </register>
    <!--   PULLDN:      Set GPIO Pull-Up register -->
    <register>
      <name>PE_LOW_CLR</name>
       <description>Pull clear:\n	
				 bit[pin*2] : 1: pullup , 0 : pulldownn
